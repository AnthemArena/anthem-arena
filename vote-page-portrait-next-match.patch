+/* ========================================
+   "NEXT MATCH" BAR: shown after you have voted (js/next-match.js, js/vote.js)
+   ======================================== */
+.next-match-bar {
+    position: fixed;
+    left: 0; right: 0; bottom: 0;
+    z-index: 900;
+    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
+    max-width: 44rem;
+    margin: 0 auto;
+    padding: 0.8rem 1.1rem calc(0.8rem + env(safe-area-inset-bottom, 0px));
+    border: 1px solid var(--border, rgba(255, 79, 180, .25));
+    border-bottom: 0;
+    border-radius: 18px 18px 0 0;
+    background: rgba(11, 13, 24, .94);
+    backdrop-filter: blur(14px);
+    box-shadow: 0 -12px 40px rgba(0, 0, 0, .45);
+    color: var(--text, #f6f3f7);
+}
+.next-bar-text { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
+.next-bar-text strong { font-size: .95rem; }
+.next-bar-text span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .78rem; color: var(--muted, #b7b2bc); }
+.next-bar-btn {
+    flex: none;
+    padding: .7rem 1.2rem;
+    border-radius: 999px;
+    background: linear-gradient(135deg, var(--pink-bright, #ff70c3), var(--pink, #ff4fb4));
+    color: #160814;
