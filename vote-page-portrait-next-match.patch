+// ========================================
+// "NEXT MATCH" BAR (shown once the visitor has voted in THIS match)
+// ========================================
+// With several matches open at once, the quickest way to more votes is to send a voter straight on to the next one.
+function updateNextMatchBar(remaining) {
+    let bar = document.getElementById('next-match-bar');
+    if (!hasVoted) {
+        if (bar) bar.remove();
+        document.body.classList.remove('has-next-bar');
+        return;
+    }
+    if (!bar) {
+        bar = document.createElement('div');
+        bar.id = 'next-match-bar';
+        bar.className = 'next-match-bar';
+        bar.setAttribute('role', 'region');
+        bar.setAttribute('aria-label', 'Next match');
+        document.body.appendChild(bar);
+    }
+    bar.innerHTML = nextMatchBarHtml(remaining);
+    document.body.classList.add('has-next-bar');
+}
+
 /**
 // LOAD OTHER LIVE MATCHES
 // ========================================
@@ -724,13 +748,11 @@ try {
         const userVotes = JSON.parse(localStorage.getItem('userVotes') || '{}');
 
         // ✅ STEP 2: Filter - only live matches user HASN'T voted on yet (excluding current match)
-        const otherLiveMatches = allMatches.filter(match => {
-            const isLive = match.status === 'live';
-            const isNotCurrentMatch = match.id !== currentMatch.id;
-            const hasNotVoted = !userVotes[match.id];
+        // (matches from the API carry `matchId`, not `id`: the old filter read match.id, so it listed the current match and voted ones too)
+        const hasVotedId = id => !!userVotes[id] || !!localStorage.getItem(`vote_${ACTIVE_TOURNAMENT}_${id}`);
+        const otherLiveMatches = unvotedLiveMatches(allMatches, { currentId: currentMatch.id, hasVoted: hasVotedId });
 
-            return isLive && isNotCurrentMatch && hasNotVoted;
-        });
+        updateNextMatchBar(otherLiveMatches);
 
         console.log(`✅ Found ${otherLiveMatches.length} unvoted live matches`);
 
diff --git a/tools/test-next-match.mjs b/tools/test-next-match.mjs
new file mode 100644
index 0000000..a2e974b
--- /dev/null
+++ b/tools/test-next-match.mjs
@@ -0,0 +1,76 @@
+// Offline tests for js/next-match.js (the vote page's "Next match" bar).   node tools/test-next-match.mjs
+import assert from 'node:assert/strict';
+import { matchKey, unvotedLiveMatches, nextMatchBarHtml } from '../js/next-match.js';
+
+let passed = 0;
+const test = (name, fn) => { fn(); passed++; console.log('  ok  ' + name); };
+const m = (n, status = 'live', extra = {}) => ({ matchId: `cup-group-A-match-${n}`, status, song1: { shortTitle: `Edit ${n}a` }, song2: { shortTitle: `Edit ${n}b` }, ...extra });
+const six = [1, 2, 3, 4, 5, 6].map(n => m(n));
+const ids = list => list.map(matchKey);
+
+test('API matches carry matchId (not id): the key is found either way', () => {
+    assert.equal(matchKey({ matchId: 'a' }), 'a');
+    assert.equal(matchKey({ id: 'b' }), 'b');
+    assert.equal(matchKey({}), null);
+    assert.equal(matchKey(null), null);
+});
+
+test('the match being voted in is never in its own "more matches" list (this was the bug: the page filtered on match.id)', () => {
+    const left = unvotedLiveMatches(six, { currentId: 'cup-group-A-match-3' });
+    assert.equal(left.length, 5);
+    assert.ok(!ids(left).includes('cup-group-A-match-3'));
+});
+
+test('matches already voted in are left out', () => {
+    const voted = new Set(['cup-group-A-match-1', 'cup-group-A-match-4']);
+    const left = unvotedLiveMatches(six, { currentId: 'cup-group-A-match-2', hasVoted: id => voted.has(id) });
+    assert.deepEqual(ids(left), ['cup-group-A-match-3', 'cup-group-A-match-5', 'cup-group-A-match-6']);
+});
+
+test('order starts just after the current match and wraps round', () => {
+    assert.deepEqual(ids(unvotedLiveMatches(six, { currentId: 'cup-group-A-match-4' })), ['cup-group-A-match-5', 'cup-group-A-match-6', 'cup-group-A-match-1', 'cup-group-A-match-2', 'cup-group-A-match-3']);
+    assert.deepEqual(ids(unvotedLiveMatches(six, { currentId: 'cup-group-A-match-6' })).slice(0, 2), ['cup-group-A-match-1', 'cup-group-A-match-2']);
+});
+
+test('only live matches count (finished and upcoming ones are never offered)', () => {
+    const mixed = [m(1), m(2, 'completed'), m(3, 'upcoming'), m(4)];
+    assert.deepEqual(ids(unvotedLiveMatches(mixed, { currentId: 'cup-group-A-match-1' })), ['cup-group-A-match-4']);
+});
+
+test('no current match (or an unknown one) lists every unvoted live match; junk input is safe', () => {
+    assert.equal(unvotedLiveMatches(six).length, 6);
+    assert.equal(unvotedLiveMatches(six, { currentId: 'nope' }).length, 6);
+    assert.deepEqual(unvotedLiveMatches(null), []);
+    assert.deepEqual(unvotedLiveMatches([null, {}, { status: 'live' }]), []);
+});
+
+test('bar: names the count, the next pairing, and links to that match', () => {
+    const html = nextMatchBarHtml(unvotedLiveMatches(six, { currentId: 'cup-group-A-match-2' }));
+    assert.ok(html.includes('5 more matches need your vote'));
+    assert.ok(html.includes('Edit 3a vs Edit 3b'));
+    assert.ok(html.includes('href="vote?match=cup-group-A-match-3"') && html.includes('Next match'));
+});
+
+test('bar: singular wording for the last match', () => {
+    const html = nextMatchBarHtml([m(5)]);
+    assert.ok(html.includes('1 more match needs your vote') && !html.includes('1 more matches'));
+});
+
+test('bar: when nothing is left it says so and points at the bracket', () => {
+    const html = nextMatchBarHtml([]);
+    assert.ok(html.includes("You've voted in every live match") && html.includes('href="brackets"') && !html.includes('Next match'));
+});
+
+test('bar: titles from YouTube are escaped', () => {
+    const evil = m(1, 'live', { song1: { shortTitle: '<img src=x onerror=alert(1)>' }, song2: { title: 'A "quoted" & <b>edit</b>' } });
+    const html = nextMatchBarHtml([evil]);
+    assert.ok(!html.includes('<img') && !html.includes('<b>edit'));
+    assert.ok(html.includes('&lt;img') && html.includes('&quot;quoted&quot; &amp;'));
+});
+
+test('bar: a match id with odd characters is encoded in the link', () => {
+    const html = nextMatchBarHtml([m(1, 'live', { matchId: 'a b&c' })]);
+    assert.ok(html.includes('href="vote?match=a%20b%26c"'));
+});
+
+console.log(`\n${passed} tests passed`);
diff --git a/tools/test-vote-browser.py b/tools/test-vote-browser.py
new file mode 100644
index 0000000..c43d3ee
--- /dev/null
+++ b/tools/test-vote-browser.py
@@ -0,0 +1,113 @@
+# Optional browser test of the REAL vote page (vote.html + js/vote.js) with mocked Firebase and a mocked /api/matches.
+#   python3 tools/test-vote-browser.py            (screenshots go to /tmp/vote-shots)
+# Checks the portrait (9:16) Shorts players at desktop and phone width, and the "Next match" bar shown after voting.
+import os, sys, json, subprocess, threading, http.server, socketserver, functools
+from urllib.parse import urlparse, parse_qs
+from playwright.sync_api import sync_playwright
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+FIX = '/tmp/bracket-fixtures'; SHOTS = '/tmp/vote-shots'
+os.makedirs(SHOTS, exist_ok=True)
+subprocess.run(['node', os.path.join(ROOT, 'tools/test-support/bracket-fixtures.mjs'), FIX], check=True, capture_output=True)
+
+class Q(http.server.SimpleHTTPRequestHandler):
+    def log_message(self, *a): pass
+httpd = socketserver.TCPServer(('127.0.0.1', 0), functools.partial(Q, directory=ROOT)); PORT = httpd.server_address[1]
+threading.Thread(target=httpd.serve_forever, daemon=True).start()
+
+FS = open(os.path.join(ROOT, 'tools/test-support/browser-firestore.js')).read()
+APP = "export const initializeApp=()=>({});"
+AUTH = "export const getAuth=()=>({currentUser:null});export const signInAnonymously=async()=>({});export const onAuthStateChanged=(a,cb)=>{setTimeout(()=>cb(null),0);return()=>{}};export const signOut=async()=>({});"
+CUP = [l for l in open(os.path.join(ROOT, 'js/arcane-config.js')).read().splitlines() if 'tournamentId:' in l][0].split("'")[1]
+failed = []
+def check(name, ok, got=None):
+    print(('  ok  ' if ok else 'FAIL  ') + name + ('' if ok else f'   got: {got}'))
+    if not ok: failed.append(name)
+
+matches = json.load(open(f'{FIX}/groups-mid-16.json'))
+live = sorted([m for m in matches if m['status'] == 'live'], key=lambda m: m['matchId'])
+CURRENT, OTHER_VOTED = live[0]['matchId'], live[1]['matchId']
+EXPECT_LEFT = len(live) - 2        # everything live except the one being viewed and the one already voted in
+
+def load(browser, width, height, voted):
+    ctx = browser.new_context(viewport={'width': width, 'height': height})
+    init = f"localStorage.setItem('username','tester');localStorage.setItem('isPublic','true');localStorage.setItem('tournamentUserId','u1');"
+    init += f"localStorage.setItem('userVotes', JSON.stringify({{'{OTHER_VOTED}': {{songId:'song1', songTitle:'x', opponentTitle:'y', timestamp:1}}}}));"
+    if voted: init += f"localStorage.setItem('vote_{CUP}_{CURRENT}','song1');"
+    ctx.add_init_script(init)
+    pg = ctx.new_page(); errs = []
+    pg.on('pageerror', lambda e: errs.append(str(e)))
+    def route(r):
+        u = r.request.url; path = urlparse(u).path
+        if 'firebase-firestore' in u: r.fulfill(body=FS, content_type='application/javascript')
+        elif 'firebase-app' in u: r.fulfill(body=APP, content_type='application/javascript')
+        elif 'firebase-auth' in u: r.fulfill(body=AUTH, content_type='application/javascript')
+        elif path.endswith('/api/matches'):
+            mid = parse_qs(urlparse(u).query).get('matchId', [None])[0]
+            body = next((m for m in matches if m['matchId'] == mid), None) if mid else matches
+            r.fulfill(body=json.dumps(body), content_type='application/json', headers={'X-Cache': 'MOCK'})
+        elif '/api/' in u: r.fulfill(body='{}', content_type='application/json')
+        elif u.startswith('https://img.youtube.com') or 'youtube.com/embed' in u: r.fulfill(body='', content_type='image/jpeg' if 'img.' in u else 'text/html')
+        elif 'gstatic.com' in u or 'googleapis' in u or 'cdnjs' in u or 'google-analytics' in u or 'googletagmanager' in u: r.fulfill(body='', content_type='text/css' if u.endswith('.css') else 'text/plain')
+        else: r.continue_()
+    pg.route('**/*', route)
+    pg.goto(f'http://127.0.0.1:{PORT}/vote.html?match={CURRENT}')
+    pg.wait_for_timeout(3500)
+    return pg, errs
+
+rect = lambda pg, sel, n=0: pg.evaluate(f"(()=>{{const e=document.querySelectorAll({json.dumps(sel)})[{n}];if(!e)return null;const r=e.getBoundingClientRect();return {{x:r.x,y:r.y,w:r.width,h:r.height,r:r.right,b:r.bottom}}}})()")
+
+with sync_playwright() as p:
+    b = p.chromium.launch()
+
+    # ---------- desktop, not voted yet ----------
+    pg, errs = load(b, 1280, 900, voted=False)
+    check('desktop: the match loaded (both edit names filled in)', 'Loading' not in pg.inner_text('#competitor1-name') and 'Loading' not in pg.inner_text('#competitor2-name'), pg.inner_text('#competitor1-name'))
+    w1, w2 = rect(pg, '.video-wrapper', 0), rect(pg, '.video-wrapper', 1)
+    check('desktop: players are portrait 9:16 (they were 16:9)', w1 and abs(w1['w'] / w1['h'] - 9 / 16) < 0.03 and abs(w2['w'] / w2['h'] - 9 / 16) < 0.03, (w1, w2))
+    check('desktop: players are capped to about 64% of the window height', w1['h'] <= 0.64 * 900 + 2, w1['h'])
+    check('desktop: both players line up side by side', abs(w1['y'] - w2['y']) < 3 and w2['x'] > w1['r'], (w1, w2))
+    vb = rect(pg, '.vote-btn', 0)
+    print(f"        info: first vote button bottom at {round(vb['b'])}px (window 900px) with the page at the top")
+    check('desktop: the player is on the first screen (at least 40% of it visible without scrolling)', w1['y'] + 0.4 * w1['h'] <= 900, w1)
+    print(f"        info: desktop player top at {round(w1['y'])}px of 900px (was about 800px before this patch)")
+    check('desktop: no next-match bar before voting', pg.query_selector('#next-match-bar') is None)
+    pg.screenshot(path=f'{SHOTS}/vote-desktop.png')
+    pg.context.close()
+
+    # ---------- phone, not voted yet ----------
+    pg, errs = load(b, 390, 844, voted=False)
+    w1 = rect(pg, '.video-wrapper', 0)
+    check('phone: player is portrait and inside the screen', w1 and abs(w1['w'] / w1['h'] - 9 / 16) < 0.03 and w1['r'] <= 390 and w1['x'] >= 0, w1)
