diff --git a/css/arcane-theme.css b/css/arcane-theme.css
index 0b79031..3289467 100644
--- a/css/arcane-theme.css
+++ b/css/arcane-theme.css
@@ -546,3 +546,108 @@ body.theme-arcane .btn-support {
     border-radius: 999px;
 }
 body.theme-arcane .btn-support:hover { color: #160814; }
+
+
+/* ========================================
+   NAVIGATION + FOOTER (js/navigation.js, js/footer.js; shared by every page)
+   ======================================== */
+
+/* ---------- navigation: glass bar over the cover, logo as a rounded badge ---------- */
+body.theme-arcane .main-nav {
+    background: rgba(6, 7, 14, .62);
+    border-bottom: 1px solid var(--line);
+    backdrop-filter: blur(18px) saturate(1.2);
+    -webkit-backdrop-filter: blur(18px) saturate(1.2);
+}
+/* logo.png is an opaque square tile with its own pink frame, so show it as a badge (as on the homepage) */
+body.theme-arcane .site-logo {
+    height: 54px;
+    width: 54px;
+    object-fit: cover;
+    border-radius: 14px;
+    border: 1px solid var(--border);
+    box-shadow: 0 0 22px rgba(255, 79, 180, .28);
+    transition: transform 180ms ease, box-shadow 180ms ease;
+}
+body.theme-arcane .site-logo:hover { transform: scale(1.06); filter: none; box-shadow: 0 0 32px rgba(255, 79, 180, .48); }
+
+body.theme-arcane .nav-links a {
+    font-family: var(--font);
+    font-weight: 700;
+    font-size: .82rem;
+    letter-spacing: .14em;
+    color: var(--muted);
+}
+body.theme-arcane .nav-links a:hover,
+body.theme-arcane .nav-links a.active { color: var(--text); }
+
+body.theme-arcane .nav-profile-card {
+    background: var(--panel);
+    border: 1px solid var(--border);
+    border-radius: 16px;
+    backdrop-filter: blur(12px);
+    -webkit-backdrop-filter: blur(12px);
+}
+body.theme-arcane .notification-bell { color: var(--pink-bright); border-radius: 12px; }
+body.theme-arcane .notification-bell:hover { background: var(--pink-soft); }
+body.theme-arcane .nav-bell-icon { display: block; filter: drop-shadow(0 0 6px rgba(255, 79, 180, .5)); }
+/* the badge is styled inline (red) by navigation.js, so this needs !important */
+body.theme-arcane .notification-badge {
+    background: linear-gradient(135deg, var(--pink-bright), var(--pink)) !important;
+    color: #160814 !important;
+    border: 2px solid var(--bg) !important;
+    box-shadow: 0 2px 10px rgba(255, 79, 180, .45) !important;
+}
+
+/* ---------- footer ---------- */
+body.theme-arcane .main-footer {
+    background: rgba(6, 7, 14, .78);
+    border-top: 1px solid var(--border);
+    backdrop-filter: blur(14px);
+    -webkit-backdrop-filter: blur(14px);
+}
+body.theme-arcane .footer-logo {
+    height: 68px;
+    width: 68px;
+    object-fit: cover;
+    border-radius: 16px;
+    border: 1px solid var(--border);
+    box-shadow: 0 0 26px rgba(255, 79, 180, .25);
+    filter: none;
+}
+body.theme-arcane .footer-heading {
+    font-family: var(--font);
+    font-size: .78rem;
+    font-weight: 800;
+    letter-spacing: .18em;
+    color: var(--pink-bright);
+}
+body.theme-arcane .footer-text { font-family: var(--font); color: var(--muted); line-height: 1.65; }
+body.theme-arcane .footer-links a { font-family: var(--font); color: var(--muted); }
+body.theme-arcane .footer-links a:hover { color: var(--pink-bright); }
+body.theme-arcane .footer-email-link { color: var(--muted); }
+body.theme-arcane .footer-email-link:hover { color: var(--pink-bright); }
+
+body.theme-arcane .social-link {
+    border: 1px solid var(--border);
+    border-radius: 50%;
+    background: rgba(255, 255, 255, .03);
+    color: var(--pink-bright);
+}
+body.theme-arcane .social-link:hover { background: var(--pink-soft); border-color: var(--pink-bright); color: var(--text); }
+
+body.theme-arcane .footer-bottom { border-top: 1px solid var(--line); }
+body.theme-arcane .footer-copyright,
+body.theme-arcane .footer-disclaimer,
+body.theme-arcane .footer-legal-links a,
+body.theme-arcane .footer-legal-links .separator { font-family: var(--font); color: var(--text-faint); }
+body.theme-arcane .footer-legal-links a:hover { color: var(--pink-bright); }
+
+body.theme-arcane .copy-success-toast {
+    font-family: var(--font);
+    font-weight: 800;
+    color: #160814;
+    background: linear-gradient(135deg, var(--pink-bright), var(--pink));
+    border-radius: 999px;
+    box-shadow: 0 12px 30px rgba(255, 79, 180, .35);
+}
