index 0000000..7b7c73f
--- /dev/null
+++ b/css/arcane-theme.css
@@ -0,0 +1,233 @@
+/* ========================================
+   ARCANE THEME: dark + pink, matching index.html (arcane-home.css)
+   ----------------------------------------
+   Opt-in per page: add class="theme-arcane" to <body> and link, AFTER the page's other stylesheets:
+       /css/arcane-theme.generated.css   (auto: old gold -> pink, built by tools/build-arcane-theme.mjs)
+       /css/arcane-theme.css             (this file: tokens, background, shapes; wins over the generated one)
+   Pages without the class are not touched.
+======================================== */
+
+:root {
+    /* same values as css/arcane-home.css */
+    --bg: #06070e;
+    --panel: rgba(11, 13, 24, .8);
+    --pink: #ff4fb4;
+    --pink-bright: #ff70c3;
+    --pink-soft: rgba(255, 79, 180, .15);
+    --text: #f6f3f7;
+    --muted: #b7b2bc;
+    --border: rgba(255, 79, 180, .25);
+    --shadow: 0 24px 80px rgba(0, 0, 0, .46);
+    --radius: 22px;
+
+    /* extras used by the converted pages */
+    --bg-veil: rgba(6, 7, 14, .72);        /* page sections: lets the cover image show through */
+    --card: rgba(7, 8, 15, .85);           /* same as .video-card on the homepage */
+    --line: rgba(255, 255, 255, .08);
+    --text-dim: #98939d;
+    --text-faint: #8f8992;
+    --font: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+/* ---------- page background: cover image + pink glow (as on the homepage) ---------- */
+body.theme-arcane {
+    background: var(--bg);                 /* must stay opaque: it is the canvas colour */
+    color: var(--text);
+    font-family: var(--font);
+}
+body.theme-arcane::before {
+    content: "";
+    position: fixed;
+    inset: 0;
+    z-index: -4;
+    pointer-events: none;
+    background: linear-gradient(180deg, rgba(5, 6, 14, .57), rgba(5, 6, 14, .92)), url("/cover.png") center / cover no-repeat;
+}
+body.theme-arcane::after {
+    content: "";
+    position: fixed;
+    inset: 0;
+    z-index: -3;
+    pointer-events: none;
+    background:
+        radial-gradient(circle at 50% 15%, rgba(255, 79, 180, .11), transparent 42%),
+        radial-gradient(420px 420px at -2% 40%, rgba(255, 79, 180, .15), transparent 70%),
+        radial-gradient(420px 420px at 102% 70%, rgba(255, 79, 180, .13), transparent 70%);
+}
+
+/* ---------- headings: bold Inter, tight tracking; small pink "eyebrow" labels ---------- */
+body.theme-arcane .page-title,
+body.theme-arcane .section-title {
+    font-family: var(--font);
+    font-weight: 800;
+    letter-spacing: -.05em;
+    line-height: 1.02;
+    text-transform: none;
+    color: var(--text);
+    text-shadow: none;
+    background: none;
+    -webkit-text-fill-color: currentColor;
+}
+body.theme-arcane .page-title { font-size: clamp(2.4rem, 6vw, 4.2rem); }
+body.theme-arcane .section-title { font-size: clamp(1.7rem, 4vw, 2.35rem); }
+body.theme-arcane .page-subtitle { font-family: var(--font); font-size: 1.1rem; color: var(--muted); }
+
+body.theme-arcane .selector-label,
+body.theme-arcane .info-label,
+body.theme-arcane .round-title,
+body.theme-arcane .matchup-number,
+body.theme-arcane .stat-label {
+    font-family: var(--font);
+    font-size: .75rem;
+    font-weight: 800;
+    letter-spacing: .18em;
+    text-transform: uppercase;
+    color: var(--pink-bright);
+}
+body.theme-arcane .round-title { font-size: .85rem; margin-bottom: .35rem; }
+body.theme-arcane .round-subtitle { color: var(--text-faint); font-size: .82rem; }
+
+/* ---------- panels (homepage: .intro-card / .support-section) ---------- */
+body.theme-arcane .brackets-header {
+    background: transparent;
+    border-bottom: 1px solid var(--line);
+}
+body.theme-arcane .tournament-info,
+body.theme-arcane .stat-card {
+    background: var(--panel);
+    border: 1px solid var(--border);
+    border-radius: var(--radius);
+    backdrop-filter: blur(14px);
+    -webkit-backdrop-filter: blur(14px);
+    box-shadow: var(--shadow);
+}
+body.theme-arcane .info-value { font-family: var(--font); font-weight: 800; letter-spacing: -.02em; color: var(--text); }
+body.theme-arcane .status-live { color: var(--pink-bright); }
+body.theme-arcane .round-header { border-bottom: 1px solid var(--border); }
+body.theme-arcane .bracket-section { background: transparent; }
+
+/* ---------- controls: pill buttons ---------- */
+body.theme-arcane .tournament-dropdown {
+    font-family: var(--font);
+    font-weight: 700;
+    background: rgba(9, 10, 19, .58);
+    border: 1px solid rgba(255, 255, 255, .13);
+    border-radius: 999px;
+    color: var(--text);
+    backdrop-filter: blur(8px);
+}
+body.theme-arcane .tournament-dropdown:hover { border-color: var(--border); background: rgba(13, 15, 27, .84); }
+body.theme-arcane .tournament-dropdown:focus { border-color: var(--pink-bright); box-shadow: 0 0 0 3px var(--pink-soft); }
+body.theme-arcane .tournament-dropdown option { background: #0d0f1b; color: var(--text); }
+
+body.theme-arcane .view-details-btn,
+body.theme-arcane .retry-btn,
+body.theme-arcane .btn-primary {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 10px;
+    min-height: 48px;
+    padding: 13px 22px;
+    border: 0;
+    border-radius: 999px;
+    font-family: var(--font);
+    font-weight: 800;
+    text-decoration: none;
+    color: #160814;
+    background: linear-gradient(135deg, var(--pink-bright), var(--pink));
+    box-shadow: 0 12px 30px rgba(255, 79, 180, .24);
+    transition: transform 180ms ease, box-shadow 180ms ease;
+}
+body.theme-arcane .view-details-btn:hover,
+body.theme-arcane .retry-btn:hover,
+body.theme-arcane .btn-primary:hover {
+    color: #160814;
+    transform: translateY(-2px);
+    box-shadow: 0 18px 36px rgba(255, 79, 180, .34);
+}
+
+/* ---------- bracket match cards (homepage: .video-card) ---------- */
+body.theme-arcane .matchup-card {
+    background: var(--card);
+    border: 1px solid var(--line);
+    border-radius: 16px;
+    box-shadow: 0 14px 34px rgba(0, 0, 0, .24);
+    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
+}
+body.theme-arcane .matchup-card:hover {
+    transform: translateY(-3px);
+    border-color: rgba(255, 79, 180, .34);
+    box-shadow: 0 20px 44px rgba(0, 0, 0, .38);
+}
+body.theme-arcane .matchup-card.live {
+    border-color: rgba(255, 79, 180, .55);
+    box-shadow: 0 0 0 1px rgba(255, 79, 180, .25), 0 14px 40px rgba(255, 79, 180, .16);
+}
+body.theme-arcane .matchup-card.completed { border-color: var(--line); }
+
+body.theme-arcane .competitor {
+    background: rgba(255, 255, 255, .03);
+    border: 1px solid transparent;
+    border-radius: 12px;
+    min-width: 0;
+}
+body.theme-arcane .competitor.winner { background: var(--pink-soft); border-color: rgba(255, 79, 180, .45); }
+body.theme-arcane .competitor.tbd .song-title { color: var(--text-dim); font-style: italic; }
+body.theme-arcane .song-thumbnail { border-radius: 10px; }
+body.theme-arcane .competitor-info { min-width: 0; }
+
+/* long YouTube titles: wrap and clamp to two lines instead of running out of the card */
+body.theme-arcane .song-title {
+    font-family: var(--font);
+    font-weight: 700;
+    line-height: 1.35;
+    overflow-wrap: anywhere;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+}
+body.theme-arcane .seed-badge {
+    border-radius: 999px;
+    background: var(--pink-soft);
+    border: 1px solid rgba(255, 79, 180, .25);
+    color: var(--pink-bright);
+}
+body.theme-arcane .vote-percentage { color: var(--pink-bright); font-weight: 800; }
+
+/* status pills */
+body.theme-arcane .status-badge {
+    border-radius: 999px;
+    font-family: var(--font);
+    font-weight: 800;
+    letter-spacing: .08em;
+}
+body.theme-arcane .status-badge.upcoming {
+    background: rgba(255, 255, 255, .06);
+    border: 1px solid rgba(255, 255, 255, .1);
+    color: var(--muted);
+}
+body.theme-arcane .status-badge.active {
+    background: linear-gradient(135deg, var(--pink-bright), var(--pink));
+    border: 0;
+    color: #160814;
+    box-shadow: 0 8px 20px rgba(255, 79, 180, .24);
+}
+body.theme-arcane .status-badge.completed,
+body.theme-arcane .status-badge.voted {
+    background: var(--pink-soft);
+    border: 1px solid var(--border);
+    color: var(--pink-bright);
+}
+
+/* ---------- stats cards ---------- */
+body.theme-arcane .stat-card { border-radius: 16px; }
+body.theme-arcane .stat-icon { color: var(--pink-bright); }
+body.theme-arcane .stat-value { font-family: var(--font); font-weight: 800; letter-spacing: -.03em; color: var(--text); }
+body.theme-arcane .stat-detail { color: var(--text-faint); }
+
+/* ---------- text links in body copy ---------- */
+body.theme-arcane .page-intro a,
+body.theme-arcane .inline-link { color: var(--pink-bright); }
+body.theme-arcane .page-intro p { color: var(--muted); }
