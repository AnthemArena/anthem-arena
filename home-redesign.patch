@@ -0,0 +1,85 @@
+/* ========================================
+   HOMEPAGE (index.html, body.page-home)
+   Uses the Arcane theme tokens from arcane-theme.css.
+   ======================================== */
+.page-home .home-page { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
+
+/* hero */
+.page-home .home-hero { text-align: center; padding: 1.5rem 0 2.5rem; display: flex; flex-direction: column; align-items: center; }
+.page-home .home-logo { width: min(220px, 52vw); height: auto; border-radius: 26px; filter: drop-shadow(0 18px 36px rgba(0,0,0,.5)); margin-bottom: 1.25rem; }
+.page-home .home-pill { margin: 0 0 .9rem; padding: .4rem .95rem; border: 1px solid var(--border); background: var(--pink-soft); border-radius: 999px; color: var(--pink-bright); font-size: .85rem; font-weight: 700; letter-spacing: .02em; max-width: 100%; overflow-wrap: anywhere; }
+.page-home .home-title { margin: 0; font-family: var(--font); font-size: clamp(2.6rem, 8vw, 4.75rem); font-weight: 800; line-height: 1; letter-spacing: -.04em; color: var(--text); }
+.page-home .home-lead { max-width: 620px; margin: 1.1rem auto 0; color: var(--muted); font-size: clamp(1rem, 2.4vw, 1.2rem); line-height: 1.6; }
+.page-home .home-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1.6rem; }
+.page-home .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: .75rem 1.4rem; border-radius: 999px; font: 700 1rem var(--font); text-decoration: none; border: 1px solid transparent; cursor: pointer; }
+.page-home .btn-primary { color: #160814; background: linear-gradient(135deg, var(--pink-bright), var(--pink)); box-shadow: 0 12px 30px rgba(255,79,180,.24); }
+.page-home .btn-primary:hover { box-shadow: 0 16px 34px rgba(255,79,180,.34); }
+.page-home .btn-ghost { color: var(--text); background: var(--card); border-color: var(--border); }
+.page-home .btn-ghost:hover { background: var(--pink-soft); }
+.page-home .btn:focus-visible, .page-home .edit-card:focus-visible, .page-home .result-list a:focus-visible, .page-home .more:focus-visible { outline: 2px solid var(--pink-bright); outline-offset: 2px; }
+.page-home .home-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin: 2rem 0 0; padding: 0; width: 100%; }
+.page-home .home-stats[hidden] { display: none; }
+.page-home .home-stats div { flex: 1 1 140px; max-width: 220px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: .9rem .8rem; }
+.page-home .home-stats dt { color: var(--muted); font-size: .85rem; order: 2; }
+.page-home .home-stats dd { margin: 0; color: var(--text); font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 800; }
+.page-home .home-stats div { display: flex; flex-direction: column; }
+
+/* blocks */
+.page-home .home-block { margin-top: 2.5rem; }
+.page-home .home-block[hidden] { display: none; }
+.page-home .block-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1rem; }
+.page-home .kicker { margin: 0 0 .25rem; color: var(--pink-bright); font-size: .75rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
+.page-home .home-block h2 { margin: 0; font-size: clamp(1.35rem, 3.6vw, 1.9rem); color: var(--text); letter-spacing: -.02em; }
+.page-home .more { color: var(--pink-bright); font-weight: 700; text-decoration: none; white-space: nowrap; }
+.page-home .more:hover { text-decoration: underline; }
+
+/* edit pictures */
+.page-home .mini { display: flex; flex-direction: column; gap: .25rem; min-width: 0; text-align: center; }
+.page-home .mini img { width: 100%; max-width: 150px; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 12px; background: var(--line); margin: 0 auto .35rem; display: block; }
+.page-home .mini b { color: var(--text); line-height: 1.3; overflow-wrap: anywhere; }
+.page-home .mini i { font-style: normal; color: var(--muted); font-size: .85rem; overflow-wrap: anywhere; }
+
+/* match of the day / champion */
+.page-home .match-card, .page-home .champion-card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.4rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
+.page-home .match-label { margin: 0; color: var(--muted); font-size: .9rem; }
+.page-home .match-pair { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: start; width: 100%; max-width: 640px; }
+.page-home .match-vs { align-self: center; color: var(--pink-bright); font-weight: 800; letter-spacing: .1em; }
+.page-home .match-votes { margin: 0; color: var(--text-dim); }
+.page-home .champion-card .mini img { max-width: 180px; }
+
+/* results */
+.page-home .result-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
+.page-home .result-list a { display: grid; grid-template-columns: 7.5rem 1fr auto; gap: .9rem; align-items: center; padding: .85rem 1rem; background: var(--card); border: 1px solid var(--border); border-radius: 14px; color: var(--muted); text-decoration: none; }
+.page-home .result-list a:hover { background: var(--pink-soft); }
+.page-home .result-label { color: var(--pink-bright); font-weight: 700; font-size: .85rem; }
+.page-home .result-text { overflow-wrap: anywhere; min-width: 0; }
+.page-home .result-text b { color: var(--text); }
+.page-home .result-votes { font-size: .85rem; color: var(--text-dim); white-space: nowrap; }
+
+/* edit rows: swipe sideways on phones */
+.page-home .edit-row { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 170px); gap: 1rem; overflow-x: auto; padding-bottom: .75rem; scroll-snap-type: x proximity; scrollbar-width: thin; }
+.page-home .edit-card { display: flex; flex-direction: column; gap: .3rem; min-width: 0; padding: .6rem; background: var(--card); border: 1px solid var(--border); border-radius: 16px; text-decoration: none; scroll-snap-align: start; }
+.page-home .edit-card:hover { background: var(--pink-soft); }
+.page-home .edit-card img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; background: var(--line); display: block; margin-bottom: .3rem; }
+.page-home .edit-card b { color: var(--text); font-size: .92rem; line-height: 1.3; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
+.page-home .edit-card i { font-style: normal; color: var(--muted); font-size: .8rem; overflow-wrap: anywhere; }
+.page-home .edit-meta { color: var(--text-dim); font-size: .8rem; margin-top: auto; }
+
+/* how it works */
+.page-home .how { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.5rem; }
+.page-home .how-list { margin: 1rem 0 0; padding: 0; list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
+.page-home .how-list li { counter-increment: s; color: var(--muted); line-height: 1.5; padding-left: 2.6rem; position: relative; }
+.page-home .how-list li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 1.9rem; height: 1.9rem; border-radius: 50%; display: grid; place-items: center; background: var(--pink-soft); border: 1px solid var(--border); color: var(--pink-bright); font-weight: 800; }
+.page-home .how-list b { color: var(--text); }
+.page-home .how-more { margin: 1.2rem 0 0; }
+.page-home .how-more a { color: var(--pink-bright); }
+
+@media (max-width: 640px) {
+    .page-home .home-page { padding: 1rem 1rem 2.5rem; }
+    .page-home .btn { flex: 1 1 100%; }
+    .page-home .match-pair { gap: .5rem; }
+    .page-home .result-list a { grid-template-columns: 1fr auto; }
+    .page-home .result-label { grid-column: 1 / -1; }
+    .page-home .block-head { flex-direction: column; align-items: flex-start; gap: .4rem; }
+    .page-home .edit-row { grid-auto-columns: minmax(138px, 150px); margin-right: -1rem; padding-right: 1rem; }
+}
