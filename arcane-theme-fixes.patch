diff --git a/css/arcane-theme.css b/css/arcane-theme.css
index 7b7c73f..2953098 100644
--- a/css/arcane-theme.css
+++ b/css/arcane-theme.css
@@ -29,32 +29,45 @@
     --font: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
 }
 
-/* ---------- page background: cover image + pink glow (as on the homepage) ---------- */
+/* ---------- page background: cover image + pink glow (as on the homepage) ----------
+   The background lives on <body> itself, with fixed layers. main.css gives <html> its own background, which stops
+   <body>'s background reaching the screen edges and hides anything placed behind it with a negative z-index,
+   so the older "pseudo-element behind the page" approach cannot work on these pages. */
+html:has(body.theme-arcane) { background: var(--bg); }
 body.theme-arcane {
-    background: var(--bg);                 /* must stay opaque: it is the canvas colour */
+    min-height: 100vh;
     color: var(--text);
     font-family: var(--font);
-}
-body.theme-arcane::before {
-    content: "";
-    position: fixed;
-    inset: 0;
-    z-index: -4;
-    pointer-events: none;
-    background: linear-gradient(180deg, rgba(5, 6, 14, .57), rgba(5, 6, 14, .92)), url("/cover.png") center / cover no-repeat;
-}
-body.theme-arcane::after {
-    content: "";
-    position: fixed;
-    inset: 0;
-    z-index: -3;
-    pointer-events: none;
-    background:
+    background-color: var(--bg);
+    background-image:
         radial-gradient(circle at 50% 15%, rgba(255, 79, 180, .11), transparent 42%),
         radial-gradient(420px 420px at -2% 40%, rgba(255, 79, 180, .15), transparent 70%),
-        radial-gradient(420px 420px at 102% 70%, rgba(255, 79, 180, .13), transparent 70%);
+        radial-gradient(420px 420px at 102% 70%, rgba(255, 79, 180, .13), transparent 70%),
+        linear-gradient(180deg, rgba(5, 6, 14, .57), rgba(5, 6, 14, .92)),
+        url("/cover.png");
+    background-repeat: no-repeat;
+    background-size: auto, auto, auto, cover, cover;
+    background-position: 0 0, 0 0, 0 0, center, center;
+    background-attachment: fixed;
 }
 
+/* every full-width section must be see-through, or it paints over the cover */
+body.theme-arcane .brackets-header,
+body.theme-arcane .bracket-loading-state,
+body.theme-arcane .bracket-section,
+body.theme-arcane .tournament-stats,
+body.theme-arcane .champion-spotlight,
+body.theme-arcane .explore-more-bracket {
+    background: transparent;
+}
+body.theme-arcane .page-intro {
+    background: rgba(6, 7, 14, .45);
+    backdrop-filter: blur(6px);
+    -webkit-backdrop-filter: blur(6px);
+    border-bottom: 1px solid var(--line);
+}
+body.theme-arcane .explore-more-bracket { border-top: 1px solid var(--line); }
+
 /* ---------- headings: bold Inter, tight tracking; small pink "eyebrow" labels ---------- */
 body.theme-arcane .page-title,
 body.theme-arcane .section-title {
@@ -231,3 +244,61 @@ body.theme-arcane .stat-detail { color: var(--text-faint); }
 body.theme-arcane .page-intro a,
 body.theme-arcane .inline-link { color: var(--pink-bright); }
 body.theme-arcane .page-intro p { color: var(--muted); }
+
+
+/* ---------- explore cards (homepage: panel cards that lift and glow pink on hover) ---------- */
+body.theme-arcane .explore-more-bracket .section-title { color: var(--text); text-align: center; }
+body.theme-arcane .explore-card-bracket {
+    background: var(--panel);
+    border: 1px solid var(--border);
+    border-radius: 18px;
+    backdrop-filter: blur(14px);
+    -webkit-backdrop-filter: blur(14px);
+    box-shadow: var(--shadow);
+    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
+}
+body.theme-arcane .explore-card-bracket:hover {
+    background: var(--panel);
+    border-color: rgba(255, 79, 180, .5);
+    transform: translateY(-3px);
+    box-shadow: 0 20px 44px rgba(0, 0, 0, .38), 0 0 0 1px rgba(255, 79, 180, .2);
+}
+body.theme-arcane .explore-card-bracket h3 { font-family: var(--font); font-weight: 800; letter-spacing: -.02em; color: var(--text); }
+body.theme-arcane .explore-card-bracket p { color: var(--muted); }
+body.theme-arcane .card-icon i { color: var(--pink-bright); }
+
+/* ---------- status colours: the old CSS sets red / blue / green with !important, so these must too ---------- */
+body.theme-arcane .info-value.status-live      { color: var(--pink-bright) !important; animation: none; }
+body.theme-arcane .info-value.status-upcoming  { color: var(--muted) !important; }
+body.theme-arcane .info-value.status-completed { color: var(--pink-bright) !important; }
+body.theme-arcane .live-dot {
+    display: inline-block;
+    width: .6em;
+    height: .6em;
+    margin-right: .5em;
+    border-radius: 50%;
+    background: var(--pink);
+    box-shadow: 0 0 12px rgba(255, 79, 180, .7);
+    animation: arcane-dot 1.1s infinite ease-in-out;
+    vertical-align: .08em;
+}
+@keyframes arcane-dot { 0%, 100% { transform: scale(.72); opacity: .5; } 50% { transform: scale(1); opacity: 1; } }
+body.theme-arcane .status-badge .live-dot { background: #160814; box-shadow: none; }
+
+/* stat icons: one colour, not blue / red / orange / gold */
+body.theme-arcane .stat-card .stat-icon i { color: var(--pink-bright); }
+
+/* ---------- live + "you voted" states: pink instead of green ---------- */
+@keyframes arcane-ring {
+    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 79, 180, .4), 0 14px 40px rgba(255, 79, 180, .14); }
+    50%      { box-shadow: 0 0 0 10px rgba(255, 79, 180, 0), 0 14px 40px rgba(255, 79, 180, .14); }
+}
+body.theme-arcane .matchup-card.live {
+    background: var(--card);
+    border-color: rgba(255, 79, 180, .55);
+    animation: arcane-ring 2s infinite;
+}
+body.theme-arcane .matchup-card.upcoming { opacity: .85; border-color: var(--line); }
+body.theme-arcane .matchup-card.finals-match { border-width: 1px; border-color: rgba(255, 79, 180, .45); background: var(--card); }
+body.theme-arcane .live-indicator { color: var(--pink-bright); }
+body.theme-arcane .competitor.leading { background: var(--pink-soft); border: 1px solid rgba(255, 79, 180, .35); }
