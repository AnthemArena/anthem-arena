+    // Firestore can answer 429/5xx for a moment. A copy that is a few minutes old beats an error page for every visitor.
+    const stale = edgeCache.get(cacheKey);
+    if (stale && (Date.now() - stale.timestamp) < STALE_OK_MS) {
