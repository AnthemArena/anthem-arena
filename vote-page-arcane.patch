--- a/css/arcane-theme.css
+++ b/css/arcane-theme.css
@@ -304,3 +304,239 @@ body.theme-arcane .matchup-card.upcoming { opacity: .85; border-color: var(--lin
 body.theme-arcane .matchup-card.finals-match { border-width: 1px; border-color: rgba(255, 79, 180, .45); background: var(--card); }
 body.theme-arcane .live-indicator { color: var(--pink-bright); }
 body.theme-arcane .competitor.leading { background: var(--pink-soft); border: 1px solid rgba(255, 79, 180, .35); }
+
+
+/* ========================================
+   VOTE PAGE (vote.html)
+   ======================================== */
+
+/* ---------- header: breadcrumb, title, badges ---------- */
+body.theme-arcane .vote-header,
+body.theme-arcane .voting-arena,
+body.theme-arcane .after-voting-section,
+body.theme-arcane .other-matches-section,
+body.theme-arcane .share-section,
+body.theme-arcane .rules-section { background: transparent; }
+body.theme-arcane .vote-header { border-bottom: 1px solid var(--line); }
+body.theme-arcane .after-voting-section,
+body.theme-arcane .share-section { border-top: 1px solid var(--line); }
+
+body.theme-arcane .breadcrumb-link,
+body.theme-arcane .breadcrumb a { color: var(--muted); }
+body.theme-arcane .breadcrumb-link:hover,
+body.theme-arcane .breadcrumb a:hover { color: var(--pink-bright); }
+body.theme-arcane .breadcrumb-separator { color: var(--text-faint); }
+body.theme-arcane .breadcrumb-current { color: var(--pink-bright); font-weight: 700; }
+
+body.theme-arcane .match-title {
+    font-family: var(--font);
+    font-weight: 800;
+    font-size: clamp(2rem, 5vw, 3.4rem);
+    letter-spacing: -.05em;
+    line-height: 1.05;
+    text-transform: none;
+    text-shadow: none;
+    color: var(--text);
+}
+body.theme-arcane .info-badge,
+body.theme-arcane #tournament-badge,
+body.theme-arcane #time-remaining {
+    font-family: var(--font);
+    font-weight: 700;
+    background: var(--panel);
+    border: 1px solid var(--border);
+    border-radius: 999px;
+    color: var(--text);
+    backdrop-filter: blur(12px);
+    -webkit-backdrop-filter: blur(12px);
+}
+/* the script colours the live badge red inline, so this needs !important */
+body.theme-arcane #time-remaining.is-live {
+    color: var(--pink-bright) !important;
+    background: var(--pink-soft);
+}
+body.theme-arcane #time-remaining.is-live i { color: var(--pink); filter: drop-shadow(0 0 6px rgba(255, 79, 180, .8)); }
+body.theme-arcane .vote-stats {
+    background: var(--panel);
+    border: 1px solid var(--border);
+    border-radius: 999px;
+    color: var(--muted);
+    font-family: var(--font);
+    backdrop-filter: blur(12px);
+    -webkit-backdrop-filter: blur(12px);
+}
+
+/* the "Vote Recorded" banner is styled inline by the script, so this needs !important */
+body.theme-arcane .voted-indicator {
+    background: var(--pink-soft) !important;
+    border: 1px solid var(--border) !important;
+    border-radius: 16px !important;
+    color: var(--text) !important;
+    font-family: var(--font);
+}
+body.theme-arcane .voted-indicator i,
+body.theme-arcane .voted-indicator strong { color: var(--pink-bright); }
+
+/* ---------- the two competitors ---------- */
+body.theme-arcane .competitor-name {
+    font-family: var(--font);
+    font-weight: 800;
+    letter-spacing: -.035em;
+    text-transform: none;
+    text-shadow: none;
+    color: var(--text);
+    overflow-wrap: anywhere;
+}
+body.theme-arcane .competitor-source { font-family: var(--font); color: var(--muted); letter-spacing: .02em; }
+body.theme-arcane .video-wrapper,
+body.theme-arcane .vote-section {
+    background: var(--card);
+    border: 1px solid var(--border);
+    border-radius: 18px;
+    box-shadow: var(--shadow);
+}
+body.theme-arcane .video-container { border-radius: 12px; }
+
+body.theme-arcane .vs-circle {
+    background: var(--panel);
+    border: 1px solid var(--border);
+    box-shadow: 0 0 40px rgba(255, 79, 180, .25);
+}
+body.theme-arcane .vs-text { font-family: var(--font); font-weight: 800; letter-spacing: .08em; color: var(--pink-bright); text-shadow: none; }
+
+body.theme-arcane .control-btn,
+body.theme-arcane .replay-btn,
+body.theme-arcane .fullscreen-btn {
+    font-family: var(--font);
+    font-weight: 700;
+    background: rgba(255, 255, 255, .04);
+    border: 1px solid rgba(255, 255, 255, .12);
+    border-radius: 999px;
+    color: var(--text);
+    transition: border-color 160ms ease, background 160ms ease;
+}
+body.theme-arcane .control-btn:hover,
+body.theme-arcane .replay-btn:hover,
+body.theme-arcane .fullscreen-btn:hover { background: var(--pink-soft); border-color: var(--border); color: var(--text); }
+
+/* ---------- percentage + vote button ---------- */
+body.theme-arcane .percentage-number,
+body.theme-arcane .vote-percentage { font-family: var(--font); font-weight: 800; letter-spacing: -.04em; color: var(--text); text-shadow: none; }
+body.theme-arcane .vote-count { color: var(--muted); font-family: var(--font); }
+
+body.theme-arcane .vote-btn {
+    font-family: var(--font);
+    font-weight: 800;
+    letter-spacing: .06em;
+    text-transform: uppercase;
+    color: #160814;
+    background: linear-gradient(135deg, var(--pink-bright), var(--pink));
+    border: 0;
+    border-radius: 999px;
+    box-shadow: 0 12px 30px rgba(255, 79, 180, .24);
+    transition: transform 180ms ease, box-shadow 180ms ease;
+}
+body.theme-arcane .vote-btn:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(255, 79, 180, .34); }
+/* "you voted for this": the old CSS forces a teal gradient with !important */
+body.theme-arcane .vote-btn.voted {
+    background: linear-gradient(135deg, var(--pink-bright), var(--pink)) !important;
+    color: #160814 !important;
+    border: 0 !important;
+    box-shadow: 0 0 34px rgba(255, 79, 180, .45) !important;
+}
+body.theme-arcane .vote-btn[disabled]:not(.voted) {
+    background: rgba(255, 255, 255, .05);
+    color: var(--text-faint);
+    border: 1px solid var(--line);
+    box-shadow: none;
+    opacity: .75;
+    filter: none;
+}
+
+/* ---------- "About this edit" ---------- */
+body.theme-arcane .details-title,
+body.theme-arcane .share-title {
+    font-family: var(--font);
+    font-size: .8rem;
+    font-weight: 800;
+    letter-spacing: .18em;
+    text-transform: uppercase;
+    color: var(--pink-bright);
+}
+body.theme-arcane .share-title { text-align: center; }
+body.theme-arcane .about-text,
+body.theme-arcane .accomplishments-text { font-family: var(--font); font-style: normal; color: var(--muted); line-height: 1.6; }
+body.theme-arcane .about-song-section,
+body.theme-arcane .accomplishments-section,
+body.theme-arcane .moment-details { background: var(--card); border: 1px solid var(--line); border-radius: 18px; }
+body.theme-arcane .meta-item {
+    font-family: var(--font);
+    background: rgba(255, 255, 255, .04);
+    border: 1px solid var(--line);
+    border-radius: 999px;
+}
+body.theme-arcane .meta-item.debut { background: var(--pink-soft); border-color: var(--border); }
+body.theme-arcane .meta-item.debut i { color: var(--pink-bright); }
+
+/* ---------- share + "what's next" ---------- */
+body.theme-arcane .share-btn {
+    font-family: var(--font);
+    font-weight: 700;
+    background: rgba(255, 255, 255, .04);
+    border: 1px solid rgba(255, 255, 255, .12);
+    border-radius: 999px;
+    color: var(--text);
+}
+body.theme-arcane .share-btn:hover { background: var(--pink-soft); border-color: var(--border); }
+body.theme-arcane .after-voting-card {
+    background: var(--panel);
+    border: 1px solid var(--border);
+    border-radius: 18px;
+    backdrop-filter: blur(14px);
+    -webkit-backdrop-filter: blur(14px);
+    box-shadow: var(--shadow);
+    transition: transform 180ms ease, border-color 180ms ease;
+}
+body.theme-arcane .after-voting-card:hover { transform: translateY(-3px); border-color: rgba(255, 79, 180, .5); background: var(--panel); }
+body.theme-arcane .after-voting-card h3 { font-family: var(--font); font-weight: 800; letter-spacing: -.02em; color: var(--text); text-transform: none; }
+body.theme-arcane .after-voting-card p { color: var(--muted); }
+body.theme-arcane .after-voting-section .card-icon,
+body.theme-arcane .after-voting-section .card-icon i,
+body.theme-arcane .card-arrow { color: var(--pink-bright); }
+
+/* ---------- post-vote modal ---------- */
+body.theme-arcane .post-vote-content {
+    background: rgba(11, 13, 24, .97);
+    border: 1px solid var(--border);
+    border-radius: var(--radius);
+    box-shadow: var(--shadow), 0 0 60px rgba(255, 79, 180, .14);
+    font-family: var(--font);
+}
+
+/* ---------- footer share band (footer.js; shared by every page) ---------- */
+body.theme-arcane .footer-cta-banner {
+    background: var(--bg-veil);
+    border-top: 1px solid var(--line);
+    border-bottom: 1px solid var(--line);
+}
+body.theme-arcane .btn-secondary {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    font-family: var(--font);
+    font-weight: 700;
+    background: rgba(255, 255, 255, .04);
+    border: 1px solid rgba(255, 255, 255, .12);
+    border-radius: 999px;
+    color: var(--text);
+}
+body.theme-arcane .btn-secondary:hover { background: var(--pink-soft); border-color: var(--border); color: var(--text); }
+body.theme-arcane .btn-support {
+    font-family: var(--font);
+    font-weight: 800;
+    color: #160814;
+    background: linear-gradient(135deg, var(--pink-bright), var(--pink));
+    border: 0;
+    border-radius: 999px;
+}
+body.theme-arcane .btn-support:hover { color: #160814; }
