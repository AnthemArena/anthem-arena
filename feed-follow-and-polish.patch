diff --git a/css/arcane-theme.css b/css/arcane-theme.css
index fc61199..09f6cbc 100644
--- a/css/arcane-theme.css
+++ b/css/arcane-theme.css
@@ -1089,3 +1089,20 @@ body.theme-arcane.page-feed .widget-match-card .competitor-result { flex: 0 0 au
 body.theme-arcane.page-feed .widget-match-card .vote-percentage { font-size: 1.05rem; }
 body.theme-arcane.page-feed .widget-match-card .view-results-btn,
 body.theme-arcane.page-feed .widget-match-card .vote-now-btn { white-space: nowrap; }
+
+/* "voted for X over Y": normal wrapping (the base post-text style preserves whitespace), the pick
+   stands out and the opponent is quieter */
+body.theme-arcane.page-feed .vote-text { white-space: normal; font-size: .98rem; font-weight: 500; line-height: 1.45; }
+body.theme-arcane.page-feed .vote-text-copy strong { font-weight: 700; }
+body.theme-arcane.page-feed .vote-opponent { color: var(--text-faint, rgba(255, 255, 255, .6)); }
+
+/* "View Results" pill in the live card: compact, no clipping, drops under the vote count if tight */
+body.theme-arcane.page-feed .widget-match-card .match-footer { flex-wrap: wrap; gap: 8px 12px; padding-top: 12px; }
+body.theme-arcane.page-feed .widget-match-card .view-results-btn,
+body.theme-arcane.page-feed .widget-match-card .vote-now-btn {
+    margin-left: auto;
+    padding: 7px 14px;
+    font-size: .78rem;
+    gap: 6px;
+}
+body.theme-arcane.page-feed .widget-match-card .view-results-btn i { display: none; }
