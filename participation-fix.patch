diff --git a/docs/arcane_moments.md b/docs/arcane_moments.md
index cd65e20..5ed93ab 100644
--- a/docs/arcane_moments.md
+++ b/docs/arcane_moments.md
@@ -399,3 +399,7 @@ People who vote in more than one cup keep their history. Votes were never delete
 - New record **Biggest upset** (also on the Records tab): the lowest seed to beat a higher seed, by seed gap. Random-draw cups have no seeds, so it is simply absent there.
 - `compareCups()` in `js/stats-model.js`; a cup whose matches fail to load is listed as "Could not load", not fatal.
 - Not included: unique voters per cup. That needs a count of distinct voters from the votes collection, which the match list cannot give. Add it with a small edge endpoint if wanted.
+
+## Participation counts opened matches only
+
+Profile participation (the circle, the round rows and Cup History) is measured against matches that have opened, not every match in the cup. With 384 group matches opening a group at a time, counting all of them left everyone at about 0% for weeks. Matches still `upcoming` are left out. Anything under 1% shows one decimal (0.3%) instead of a flat 0%. The group stage is one row named "Group stage".
diff --git a/js/cup-history-model.js b/js/cup-history-model.js
index aeb65bd..9b0a6a2 100644
--- a/js/cup-history-model.js
+++ b/js/cup-history-model.js
@@ -6,6 +6,8 @@
 // cups          entries from data/cups.json. Only these cups count, so test cups never appear.
 // matchesByCup  { [cupId]: match[] } as returned by /api/matches?tournament=<cupId>. A cup may be missing (request failed).
 
+// Under 1% would round to a flat 0%, which reads as nothing: show one decimal there.
+const pctOf = (a, b) => { const x = (a / b) * 100; return x > 0 && x < 1 ? Math.max(0.1, Math.round(x * 10) / 10) : Math.round(x); };
 const sideOf = (match, id) => (id && (id === match.song1?.id || id === 'song1') ? 1 : id && (id === match.song2?.id || id === 'song2') ? 2 : 0);
 const cleanTitle = c => String(c?.shortTitle || c?.title || c?.name || '').replace(/\s*#\w+/g, '').trim();
 
@@ -25,7 +27,8 @@ export function buildCupHistory({ votes = [], cups = [], matchesByCup = {} } = {
         const matches = matchesByCup[cup.id];
         const known = Array.isArray(matches) && matches.length > 0;
         const index = new Map((known ? matches : []).map(m => [m.matchId || m.id, m]));
-        const real = known ? matches.filter(m => m.song1?.id !== 'TBD' && m.song2?.id !== 'TBD') : [];
+        // Matches that have opened: a cup still building its later rounds should not count them against the voter.
+        const real = known ? matches.filter(m => m.song1?.id !== 'TBD' && m.song2?.id !== 'TBD' && m.status !== 'upcoming') : [];
 
         let decided = 0, correct = 0, lastPick = null;
         const picks = [];
@@ -47,7 +50,7 @@ export function buildCupHistory({ votes = [], cups = [], matchesByCup = {} } = {
             id: cup.id, name: cup.name || cup.id, status: cup.status || 'complete', startDate: cup.startDate || null, champion: cup.champion || null,
             votes: mine.size,
             totalMatches: total || null,
-            participation: total ? Math.min(100, Math.round(mine.size / total * 100)) : null,
+            participation: total ? Math.min(100, pctOf(mine.size, total)) : null,
             decided, correct,
             accuracy: decided ? Math.round(correct / decided * 100) : null,
             picks
@@ -64,7 +67,7 @@ export function buildCupHistory({ votes = [], cups = [], matchesByCup = {} } = {
         lifetime: {
             totalVotes: rows.reduce((s, r) => s + r.votes, 0),
             cupsEntered: rows.length,
-            avgParticipation: withPct.length ? Math.round(withPct.reduce((s, r) => s + r.participation, 0) / withPct.length) : null,
+            avgParticipation: withPct.length ? pctOf(withPct.reduce((s, r) => s + r.participation, 0), withPct.length * 100) : null,
             accuracy: decided ? Math.round(correct / decided * 100) : null,
             decided
         }
diff --git a/js/profile-page.js b/js/profile-page.js
index 03c7dd9..ccf66d9 100644
--- a/js/profile-page.js
+++ b/js/profile-page.js
@@ -2500,10 +2500,25 @@ async function calculateTournamentParticipation(userId) {
         const { getAllMatches } = await import('./api-client.js');
         const allMatches = await getAllMatches();
 
+        // Only matches that have opened can be voted on, so only those count. Measuring against all 384 group
+        // matches would leave everyone near 0% while the groups open one at a time.
         const tournamentMatches = allMatches.filter(
-            match => match.tournament === CURRENT_TOURNAMENT
+            match => match.tournament === CURRENT_TOURNAMENT && match.status !== 'upcoming'
         );
 
+        // Group stage matches all share round 1, so name that row from the matches themselves.
+        const roundLabels = {};
+        tournamentMatches.forEach(match => {
+            const num = parseInt(String(match.round ?? 1).replace(/\D/g, ''), 10) || 1;
+            if (!roundLabels[num]) roundLabels[num] = match.stage === 'group' ? 'Group stage' : (match.roundLabel || '');
+        });
+        // Under 1% would round to a flat 0%, which reads as "nothing". Show one decimal there instead.
+        const pctOf = (a, b) => {
+            if (!b) return 0;
+            const x = (a / b) * 100;
+            return x > 0 && x < 1 ? Math.max(0.1, Math.round(x * 10) / 10) : Math.round(x);
+        };
+
         console.log(
             `📊 Found ${tournamentMatches.length} matches in ${TOURNAMENT_NAME}`
         );
