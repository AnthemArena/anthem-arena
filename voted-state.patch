From a5bdabe7cf76e59dbc7f634432e126df1ce319c9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 19:45:42 +0000
Subject: [PATCH] Brackets page: voted state on group match rows (tick on your
 pick, dimmed other edit, Voted tag, n/6 voted counter)

---
 css/brackets-groups.css        | 13 ++++++++++
 js/brackets-groups.js          | 39 ++++++++++++++++++++++--------
 js/brackets.js                 |  2 +-
 tools/test-brackets-browser.py | 25 +++++++++++++++++++-
 tools/test-brackets-groups.mjs | 43 ++++++++++++++++++++++++++++++++++
 5 files changed, 110 insertions(+), 12 deletions(-)

diff --git a/css/brackets-groups.css b/css/brackets-groups.css
index 544240e..b0111b4 100644
--- a/css/brackets-groups.css
+++ b/css/brackets-groups.css
@@ -156,6 +156,19 @@
 .gs-tag-done { color: var(--gs-dim); border: 1px solid var(--gs-line); }
 .gs-tag-soon { color: #ffd666; border: 1px solid rgba(255, 214, 102, .35); }
 
+/* ---------- voted state: the visitor's own pick ---------- */
+.gs-voted-note { display: block; margin: -.2rem 0 .6rem; font-size: .74rem; font-weight: 700; letter-spacing: .04em; color: var(--gs-dim); font-variant-numeric: tabular-nums; }
+.gs-voted-all { color: var(--gs-pink-bright); }
+/* a voted row is quieter than an open one: it is done, as far as this visitor is concerned, but it still opens the match to see the result */
+.gs-match.live.gs-voted a { border-color: var(--gs-line); background: rgba(255, 255, 255, .03); }
+.gs-match.live.gs-voted a:hover { border-color: var(--gs-border); background: rgba(255, 255, 255, .06); }
+.gs-tag-voted { border: 1px solid var(--gs-line); background: rgba(255, 255, 255, .04); color: var(--gs-muted); }
+.gs-picked .gs-side-name { color: var(--gs-text); font-weight: 700; }
+.gs-picked .gs-pct { color: var(--gs-pink-bright); }
+.gs-check { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 1.05rem; height: 1.05rem; margin-right: -.1rem; border-radius: 50%; background: var(--gs-pink); color: #160814; font-size: .66rem; font-weight: 900; line-height: 1; align-self: center; }
+.gs-side.gs-picked { box-shadow: inset 3px 0 0 var(--gs-pink); padding-left: .45rem; margin-left: -.65rem; border-radius: 4px; }
+.gs-side.gs-dimmed { opacity: .5; }
+
 /* ---------- Knockout tab: the note shown until the knockout exists ---------- */
 .ko-note { max-width: 40rem; margin: 2.5rem auto; padding: 2rem 1.6rem; text-align: center; border: 1px solid var(--gs-border, rgba(255, 79, 180, .28)); border-radius: var(--radius, 22px); background: var(--gs-panel, rgba(11, 13, 24, .78)); color: var(--gs-text, #f6f3f7); }
 .ko-note-icon { font-size: 2rem; }
diff --git a/js/brackets-groups.js b/js/brackets-groups.js
index 52a4fac..e9d005c 100644
--- a/js/brackets-groups.js
+++ b/js/brackets-groups.js
@@ -60,38 +60,57 @@ function rowHtml(row, rank, complete) {
         </tr>`;
 }
 
-function matchRowHtml(m, { userVoted }) {
+// The voter's pick in a match: 'song1' | 'song2' | null. opts.userChoice(matchId) returns it (from localStorage on the page).
+// Older callers pass only opts.userVoted(matchId) (a yes/no): that still counts as voted, with no side to mark.
+function pickOf(m, opts) {
+    const choice = opts.userChoice ? opts.userChoice(m.matchId) : null;
+    const side = choice === 'song1' || choice === 'song2' ? choice : null;
+    const voted = !!side || !!(opts.userChoice ? choice : opts.userVoted && opts.userVoted(m.matchId));
+    return { side, voted };
+}
+
+function matchRowHtml(m, opts) {
     const done = m.status === 'completed', live = m.status === 'live';
-    const showPct = done || userVoted(m.matchId);
+    const { side, voted } = pickOf(m, opts);
+    const showPct = done || voted;
     const total = m.totalVotes || ((m.song1?.votes || 0) + (m.song2?.votes || 0));
     const pct = song => (showPct && total > 0) ? `<b class="gs-pct">${Math.round(((song.votes || 0) / total) * 100)}%</b>` : '';
     const win1 = done && m.winnerId === m.song1.id, win2 = done && m.winnerId === m.song2.id;
+    // the voter's pick is marked with a tick; in a live match the other edit is dimmed (a finished match keeps its winner styling)
+    const sideClass = (n, win) => `gs-side${win ? ' gs-win' : ''}${side === n ? ' gs-picked' : ''}${live && side && side !== n ? ' gs-dimmed' : ''}`;
+    const tick = n => side === n ? '<span class="gs-check" title="Your vote" aria-label="Your vote">&#10003;</span>' : '';
     const tag = done ? '<span class="gs-tag gs-tag-done">Final</span>'
+        : live && voted ? '<span class="gs-tag gs-tag-voted">&#10003; Voted</span>'
         : live ? '<span class="gs-tag gs-tag-live"><span class="live-dot"></span>Vote</span>'
         : '<span class="gs-tag gs-tag-soon">Soon</span>';
     return `
-        <li class="gs-match ${esc(m.status)}">
-            <a href="vote?match=${encodeURIComponent(m.matchId)}" data-match-id="${esc(m.matchId)}" data-status="${esc(m.status)}">
-                <span class="gs-side${win1 ? ' gs-win' : ''}"><span class="gs-side-name">${esc(short(m.song1))}</span>${pct(m.song1)}</span>
+        <li class="gs-match ${esc(m.status)}${voted ? ' gs-voted' : ''}">
+            <a href="vote?match=${encodeURIComponent(m.matchId)}" data-match-id="${esc(m.matchId)}" data-status="${esc(m.status)}"${voted ? ' data-voted="true"' : ''}>
+                <span class="${sideClass('song1', win1)}">${tick('song1')}<span class="gs-side-name">${esc(short(m.song1))}</span>${pct(m.song1)}</span>
                 <span class="gs-vs">vs</span>
-                <span class="gs-side${win2 ? ' gs-win' : ''}"><span class="gs-side-name">${esc(short(m.song2))}</span>${pct(m.song2)}</span>
+                <span class="${sideClass('song2', win2)}">${tick('song2')}<span class="gs-side-name">${esc(short(m.song2))}</span>${pct(m.song2)}</span>
                 ${tag}
             </a>
         </li>`;
 }
 
 export function groupCardHtml(view, opts = {}) {
-    const userVoted = opts.userVoted || (() => false);
     const total = view.matches.length;
+    const votedCount = view.matches.filter(m => pickOf(m, opts).voted).length;
+    const openCount = view.matches.filter(m => m.status === 'live').length;
     const progress = view.complete ? 'Finished' : `${view.played} of ${total} played`;
+    // while matches are open, say how many of them this visitor has voted in; the count inside the Matches list is "voted / total"
+    const votedNote = openCount && !view.complete
+        ? `<span class="gs-voted-note${votedCount === total ? ' gs-voted-all' : ''}">${votedCount === total ? '&#10003; ' : ''}You voted ${votedCount}/${total}</span>` : '';
     return `
-        <article class="gs-card" id="group-${esc(view.name)}" data-group="${esc(view.name)}" data-state="${view.state}">
+        <article class="gs-card" id="group-${esc(view.name)}" data-group="${esc(view.name)}" data-state="${view.state}" data-voted="${votedCount}">
             <header class="gs-card-head">
                 <h3 class="gs-card-title">Group ${esc(view.name)}</h3>
                 <span class="gs-progress${view.live ? ' gs-progress-live' : ''}${view.complete ? ' gs-progress-done' : ''}">
                     ${view.live ? '<span class="live-dot"></span>' : ''}${view.live ? `${view.live} live` : progress}
                 </span>
             </header>
+            ${votedNote}
             <table class="gs-table">
                 <caption class="gs-sr">Group ${esc(view.name)} standings</caption>
                 <thead><tr><th class="gs-rank">#</th><th>Edit</th><th class="gs-num">W-L</th><th class="gs-num">Share</th><th class="gs-flag"><span class="gs-sr">Status</span></th></tr></thead>
@@ -99,8 +118,8 @@ export function groupCardHtml(view, opts = {}) {
             </table>
             ${view.unresolvedTie ? '<p class="gs-note">Places 2 and 3 were level on everything: decided by draw position.</p>' : ''}
             <details class="gs-matches"${view.live ? ' open' : ''}>
-                <summary>Matches <span class="gs-count">${view.played}/${total}</span></summary>
-                <ul class="gs-match-list">${view.matches.map(m => matchRowHtml(m, { userVoted })).join('')}</ul>
+                <summary>Matches <span class="gs-count">${votedCount}/${total} voted</span></summary>
+                <ul class="gs-match-list">${view.matches.map(m => matchRowHtml(m, opts)).join('')}</ul>
             </details>
         </article>`;
 }
diff --git a/js/brackets.js b/js/brackets.js
index 68aaf7b..4398587 100644
--- a/js/brackets.js
+++ b/js/brackets.js
@@ -766,7 +766,7 @@ function renderStageViews(matches) {
     const fromHash = location.hash === '#knockout' ? 'knockout' : location.hash === '#groups' ? 'groups' : null;
     currentStage = fromHash || currentStage || defaultStage(matches, bracketInfo);
 
-    if (groupsEl) groupsEl.innerHTML = groupStageHtml(views, bracketInfo, { userVoted: checkUserVoted });
+    if (groupsEl) groupsEl.innerHTML = groupStageHtml(views, bracketInfo, { userVoted: checkUserVoted, userChoice: getUserVotedSongId });
     if (tabsEl) tabsEl.innerHTML = stageTabsHtml({ active: currentStage, info: bracketInfo, groupViews: views });
     if (noteEl) noteEl.innerHTML = bracketInfo.knockoutBuilt ? '' : knockoutNoteHtml(bracketInfo, getRoundName(bracketInfo.firstKnockoutRound));
     setupStageHandlers();
diff --git a/tools/test-brackets-browser.py b/tools/test-brackets-browser.py
index 6ea6742..603779b 100644
--- a/tools/test-brackets-browser.py
+++ b/tools/test-brackets-browser.py
@@ -23,10 +23,11 @@ def check(name, ok, got=None):
     print(('  ok  ' if ok else 'FAIL  ') + name + ('' if ok else f'   got: {got}'))
     if not ok: failed.append(name)
 
-def load(browser, scenario, width=1280, height=900, mutate=None, scale=1):
+def load(browser, scenario, width=1280, height=900, mutate=None, scale=1, init=None):
     matches = json.load(open(f'{FIX}/{scenario}.json'))
     if mutate: matches = mutate(matches)
     ctx = browser.new_context(viewport={'width': width, 'height': height}, device_scale_factor=scale)
+    if init: ctx.add_init_script(init)
     pg = ctx.new_page(); errs = []
     pg.on('pageerror', lambda e: errs.append(str(e)))
     def route(r):
@@ -159,6 +160,28 @@ with sync_playwright() as p:
     check('phone: the three filter chips share one row', pg.eval_on_selector_all('.gs-chip', 'els=>new Set(els.map(e=>Math.round(e.getBoundingClientRect().top))).size') == 1)
     pg.click('.stage-tab[data-stage="knockout"]'); pg.wait_for_timeout(1300); pg.screenshot(path=f'{SHOTS}/knockout-note-phone.png')
     pg.context.close()
+    # ---------- voted state: the visitor's own picks (stored by vote.js as localStorage vote_<cup>_<matchId> = song1 | song2) ----------
+    cup = [l for l in open(os.path.join(ROOT, 'js/arcane-config.js')).read().splitlines() if 'tournamentId:' in l][0].split("'")[1]
+    live = [m for m in json.load(open(f'{FIX}/groups-mid-16.json')) if m['status'] == 'live' and m['stage'] == 'group']
+    live.sort(key=lambda m: m['matchId'])
+    picks = {live[0]['matchId']: 'song2', live[1]['matchId']: 'song1'}
+    init = ''.join(f"localStorage.setItem('vote_{cup}_{k}','{v}');" for k, v in picks.items())
+    pg, errs = load(b, 'groups-mid-16', init=init)
+    card = pg.locator('.gs-card[data-state="live"]').first
+    check('voted: counter reads 2/6 voted and the header note says so', '2/6 voted' in card.inner_text().lower() and 'you voted 2/6' in card.inner_text().lower(), card.inner_text()[:200])
+    card.locator('summary').scroll_into_view_if_needed()
+    check('voted: 2 rows show the quiet Voted tag, 4 still say Vote', card.locator('.gs-tag-voted').count() == 2 and card.locator('.gs-tag-live').count() == 4)
+    first = card.locator(f'a[data-match-id="{live[0]["matchId"]}"]')
+    check('voted: second edit ticked (pick song2), first dimmed', first.locator('.gs-side').nth(1).get_attribute('class').count('gs-picked') == 1 and 'gs-dimmed' in first.locator('.gs-side').nth(0).get_attribute('class'))
+    check('voted: percentages only on voted rows', card.locator('.gs-pct').count() == 4, card.locator('.gs-pct').count())
+    check('voted: voted row still links to the match page', first.get_attribute('href').startswith('vote?match='))
+    card.screenshot(path=f'{SHOTS}/groups-voted-card.png')
+    pg.set_viewport_size({'width': 390, 'height': 900}); pg.wait_for_timeout(300)
+    check('voted (phone): no sideways scroll', pg.evaluate('document.documentElement.scrollWidth <= innerWidth'))
+    card.screenshot(path=f'{SHOTS}/groups-voted-card-phone.png')
+    check('voted: no page errors', not errs, errs)
+    pg.context.close()
+
     b.close()
 
 print('\n' + ('ALL CHECKS PASSED' if not failed else f'{len(failed)} FAILED'))
diff --git a/tools/test-brackets-groups.mjs b/tools/test-brackets-groups.mjs
index 1d8dc74..54566de 100644
--- a/tools/test-brackets-groups.mjs
+++ b/tools/test-brackets-groups.mjs
@@ -196,4 +196,47 @@ test('info panel: knockout built, live, and champion', () => {
     assert.match(champ.statusText, /^🏆 Champion: Edit \d+$/); assert.equal(champ.statusClass, 'status-completed'); assert.equal(champ.progress, '31 / 31 Matches');
 });
 
+test('voted state: tick on the pick, other edit dimmed, VOTED tag, counter "n/6 voted", header note', () => {
+    const v = buildGroupViews(midway().ms);                       // group B (v[1]) is live: 6 open matches
+    const b = v[1], id1 = b.matches[0].matchId, id2 = b.matches[1].matchId;
+    const choices = { [id1]: 'song2', [id2]: 'song1' };
+    const html = groupCardHtml(b, { userChoice: id => choices[id] || null });
+    assert.ok(html.includes('2/6 voted') && html.includes('You voted 2/6') && html.includes('data-voted="2"'));
+    assert.equal((html.match(/gs-tag-voted/g) || []).length, 2);                   // two voted rows get the quiet tag
+    assert.equal((html.match(/gs-tag-live/g) || []).length, 4);                    // the other four still say Vote
+    assert.equal((html.match(/gs-check/g) || []).length, 2);                       // one tick per voted match
+    assert.equal((html.match(/gs-dimmed/g) || []).length, 2);                      // the edit not picked is dimmed
+    const row1 = html.split('<li').find(x => x.includes(id1));                     // picked song2: the second side carries the tick
+    assert.ok(row1.indexOf('gs-picked') > row1.indexOf('gs-vs'));
+    assert.ok(row1.includes('gs-pct'));                                            // percentages appear on voted rows only
+    assert.equal((html.match(/gs-pct/g) || []).length, 4);                         // 2 voted rows x 2 sides
+});
+
+test('voted state: nothing voted = no ticks, "0/6 voted", no pick styling', () => {
+    const v = buildGroupViews(midway().ms);
+    const html = groupCardHtml(v[1], { userChoice: () => null });
+    assert.ok(html.includes('0/6 voted') && html.includes('You voted 0/6'));
+    assert.ok(!/gs-check|gs-picked|gs-dimmed|gs-tag-voted|gs-pct/.test(html));
+});
+
+test('voted state: voted in every open match reads as done; finished groups have no header note; finished matches keep winner styling', () => {
+    const v = buildGroupViews(midway().ms);
+    const all = groupCardHtml(v[1], { userChoice: () => 'song1' });
+    assert.ok(all.includes('gs-voted-all') && all.includes('6/6 voted'));
+    const done = groupCardHtml(v[0], { userChoice: m => 'song1' });                // group A is finished
+    assert.ok(!done.includes('gs-voted-note'));
+    assert.equal((done.match(/gs-dimmed/g) || []).length, 0);                      // finished: no dimming, the winner is already marked
+    assert.equal((done.match(/gs-win/g) || []).length, 6);
+    assert.equal((done.match(/gs-check/g) || []).length, 6);                       // the pick is still ticked
+    assert.ok(!groupCardHtml(v[3], { userChoice: () => null }).includes('gs-voted-note'));   // an upcoming group has nothing open: no note
+});
+
+test('voted state: the old yes/no option still works and an unknown stored value is not marked as a side', () => {
+    const v = buildGroupViews(midway().ms);
+    const yes = groupCardHtml(v[1], { userVoted: () => true });
+    assert.ok(yes.includes('6/6 voted') && !yes.includes('gs-check'));
+    const odd = groupCardHtml(v[1], { userChoice: () => 'banana' });
+    assert.ok(odd.includes('6/6 voted') && !odd.includes('gs-check') && !odd.includes('gs-dimmed'));
+});
+
 console.log(`\n${passed} tests passed`);
-- 
2.43.0

