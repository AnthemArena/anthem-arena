+        const b = buildMatches({ cupId: CUP, cupName: 'x', entries: selectEntries([...edits(size)].reverse(), CUP).entries, drawSeed: 'z' });
+        assert.deepEqual(a.filter(x => x.round === 1).map(x => x.song1.id), b.filter(x => x.round === 1).map(x => x.song1.id));
+    }
