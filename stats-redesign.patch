+/* ========================================
+   STATS (stats.html, body.page-stats)
+   Uses the Arcane theme tokens from arcane-theme.css.
+   ======================================== */
+.page-stats .stats-page { max-width: 1100px; margin: 0 auto; padding: 2.5rem 1.25rem 3rem; }
+.page-stats .stats-hero { text-align: center; margin-bottom: 1.5rem; }
+.page-stats .stats-title { margin: 0 0 .6rem; font-family: var(--font); font-size: clamp(2rem, 6vw, 3.25rem); font-weight: 800; letter-spacing: -.01em; color: var(--text); }
+.page-stats .stats-subtitle { max-width: 640px; margin: 0 auto; color: var(--muted); font-size: 1.05rem; line-height: 1.55; }
+.page-stats .stats-updated { margin: .6rem 0 0; color: var(--text-faint); font-size: .85rem; min-height: 1.2em; }
+
+/* tabs: one row that scrolls sideways on narrow phones instead of wrapping */
+.page-stats .stats-tabs { display: flex; gap: .5rem; overflow-x: auto; padding: .25rem 0 .75rem; margin-bottom: 1rem; scrollbar-width: none; }
+.page-stats .stats-tabs::-webkit-scrollbar { display: none; }
+.page-stats .stats-tab { flex: 1 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px; padding: .55rem 1.1rem;
+    background: var(--card); border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font: 600 .95rem var(--font); cursor: pointer; white-space: nowrap; }
+.page-stats .stats-tab:hover { color: var(--text); background: var(--pink-soft); }
+.page-stats .stats-tab.is-active { color: var(--text); background: var(--pink-soft); border-color: var(--pink-bright); }
+.page-stats .stats-tab:focus-visible, .page-stats .next-link:focus-visible, .page-stats .record-card:focus-visible { outline: 2px solid var(--pink-bright); outline-offset: 2px; }
+.page-stats .stats-pane[hidden] { display: none; }
+.page-stats .stats-message { text-align: center; color: var(--muted); padding: 2.5rem 1rem; }
+.page-stats .stats-retry { margin-left: .5rem; padding: .4rem .9rem; background: var(--pink-soft); border: 1px solid var(--pink-bright); border-radius: 999px; color: var(--text); font: 600 .9rem var(--font); cursor: pointer; }
+.page-stats .stats-note { color: var(--muted); text-align: center; margin: 1rem 0; }
+
+/* overview */
+.page-stats .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
+.page-stats .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 1.2rem 1rem; text-align: center; display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
+.page-stats .stat-card i { color: var(--pink-bright); font-size: 1.2rem; }
+.page-stats .stat-card strong { font-size: clamp(1.6rem, 4vw, 2.2rem); color: var(--text); line-height: 1.1; }
+.page-stats .stat-card strong small { font-size: .5em; color: var(--muted); font-weight: 600; }
+.page-stats .stat-card span { color: var(--muted); font-size: .9rem; }
+.page-stats .panel { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 1.2rem; margin-top: 1rem; }
+.page-stats .panel h2 { margin: 0 0 .9rem; font-size: 1.1rem; color: var(--text); }
+.page-stats .round-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
+.page-stats .round-row { display: grid; grid-template-columns: minmax(90px, 160px) 1fr auto; gap: .8rem; align-items: center; color: var(--muted); font-size: .92rem; }
+.page-stats .round-name { color: var(--text); font-weight: 600; overflow-wrap: anywhere; }
+.page-stats .round-bar, .page-stats .share-bar { display: block; height: 8px; border-radius: 99px; background: var(--line); overflow: hidden; }
+.page-stats .round-bar i, .page-stats .share-bar i { display: block; height: 100%; background: var(--pink-bright); border-radius: 99px; }
+
+/* toolbars */
+.page-stats .stats-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem .8rem; margin-bottom: 1rem; color: var(--muted); font-size: .9rem; }
+.page-stats .stats-toolbar input, .page-stats .stats-toolbar select { min-height: 44px; padding: .5rem .8rem; background: var(--card); border: 1px solid var(--border); border-radius: 12px; color: var(--text); font: 500 .95rem var(--font); max-width: 100%; }
+.page-stats .stats-toolbar input { flex: 1 1 220px; min-width: 0; }
+
+/* edit ranking */
+.page-stats .edit-rank { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
+.page-stats .rank-row { display: grid; grid-template-columns: 2.2rem 96px 1fr auto; gap: .9rem; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: .7rem .9rem .7rem .7rem; }
+.page-stats .rank-pos { text-align: center; font-weight: 800; color: var(--pink-bright); font-size: 1.1rem; }
+.page-stats .rank-row img { width: 96px; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; background: var(--line); display: block; }
+.page-stats .rank-main { display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
+.page-stats .rank-title { color: var(--text); overflow-wrap: anywhere; line-height: 1.3; }
+.page-stats .rank-by { color: var(--muted); font-size: .85rem; overflow-wrap: anywhere; }
+.page-stats .rank-nums { display: flex; flex-direction: column; align-items: flex-end; text-align: right; gap: .1rem; color: var(--muted); font-size: .8rem; }
+.page-stats .rank-nums b { color: var(--text); font-size: 1.3rem; line-height: 1; }
+.page-stats .rank-nums em { font-style: normal; color: var(--text-dim); margin-top: .25rem; }
+
+/* groups */
+.page-stats .group-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
+.page-stats .group-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 1rem; min-width: 0; }
+.page-stats .group-card h2 { margin: 0 0 .7rem; font-size: 1.05rem; color: var(--text); display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; }
+.page-stats .group-card h2 small { font-size: .75rem; font-weight: 600; color: var(--text-faint); }
+.page-stats .group-card.is-done h2 small { color: var(--pink-bright); }
+.page-stats .group-card ol { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
+.page-stats .group-card li { display: grid; grid-template-columns: 1.4rem 1fr auto auto; gap: .6rem; align-items: center; padding: .5rem .55rem; border-radius: 10px; border: 1px solid transparent; font-size: .9rem; color: var(--muted); }
+.page-stats .group-card li.is-through { background: var(--pink-soft); border-color: var(--border); }
+.page-stats .g-pos { font-weight: 800; color: var(--pink-bright); text-align: center; }
+.page-stats .g-name { display: flex; flex-direction: column; min-width: 0; }
+.page-stats .g-name b { color: var(--text); font-weight: 600; overflow-wrap: anywhere; line-height: 1.25; }
+.page-stats .g-name i { font-style: normal; font-size: .78rem; color: var(--text-dim); overflow-wrap: anywhere; }
+.page-stats .g-rec, .page-stats .g-votes { font-variant-numeric: tabular-nums; text-align: right; }
+.page-stats .g-votes { min-width: 2.6rem; color: var(--text); }
+.page-stats .g-tie { margin: .7rem 0 0; font-size: .8rem; color: var(--text-dim); }
+
+/* records */
+.page-stats .record-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
+.page-stats .record-card { display: flex; flex-direction: column; gap: .5rem; background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 1.2rem; color: inherit; text-decoration: none; min-width: 0; }
+a.record-card:hover { background: var(--pink-soft); }
+.page-stats .record-card > i { color: var(--pink-bright); font-size: 1.3rem; }
+.page-stats .record-card h2 { margin: 0; font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
+.page-stats .record-match { margin: 0; color: var(--text); line-height: 1.4; overflow-wrap: anywhere; }
+.page-stats .record-match span { color: var(--text-faint); }
+.page-stats .record-line { margin: 0; color: var(--text); font-weight: 600; }
+.page-stats .record-label { color: var(--text-dim); font-size: .82rem; }
+
+/* next links */
+.page-stats .stats-next { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .8rem; margin-top: 2.5rem; }
+.page-stats .next-link { display: flex; align-items: center; justify-content: center; gap: .6rem; min-height: 48px; padding: .75rem 1rem; background: var(--card); border: 1px solid var(--border); border-radius: 14px; color: var(--text); text-decoration: none; font-weight: 600; }
+.page-stats .next-link i { color: var(--pink-bright); }
+.page-stats .next-link:hover { background: var(--pink-soft); }
+
+@media (max-width: 760px) {
+    .page-stats .stats-page { padding: 1.75rem 1rem 2.5rem; }
+    .page-stats .stat-grid { grid-template-columns: repeat(2, 1fr); gap: .75rem; }
+    .page-stats .stats-tab { padding: .55rem .9rem; }
+    .page-stats .rank-row { grid-template-columns: 1.6rem 64px 1fr; gap: .65rem; }
+    .page-stats .rank-row img { width: 64px; }
+    .page-stats .rank-nums { grid-column: 2 / -1; flex-direction: row; align-items: baseline; justify-content: flex-start; flex-wrap: wrap; gap: .2rem .5rem; text-align: left; }
+    .page-stats .rank-nums b { font-size: 1.05rem; }
+    .page-stats .rank-nums em { margin: 0 0 0 auto; }
+    .page-stats .round-row { grid-template-columns: 1fr auto; }
+    .page-stats .round-bar { grid-column: 1 / -1; order: 3; }
+    .page-stats .group-grid, .page-stats .record-grid { grid-template-columns: 1fr; }
+}
+@media (prefers-reduced-motion: no-preference) { .page-stats .round-bar i, .page-stats .share-bar i { transition: width .4s ease; } }
+@media (max-width: 480px) {
+    .page-stats .stats-tab { padding: .55rem .6rem; font-size: .88rem; }
+    .page-stats .stats-tab i { display: none; }
+}
