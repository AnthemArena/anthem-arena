From 16556ed0f516f7efc7aa839a0c15ed0963aa6e22 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 07:08:58 +0000
Subject: [PATCH] Vote page on phones: vote button no longer a blob, About
 blocks below both players; modal: results on first screen and aligned; no
 '0/6 voted' on groups with nothing open

---
 css/arcane-theme.css           | 16 ++++++++++++++++
 css/modal.css                  | 23 +++++++++++++++++++++++
 css/vote.css                   | 21 +++++++++++++++++++++
 js/brackets-groups.js          |  4 +++-
 js/vote.js                     |  6 ++++++
 tools/test-brackets-browser.py |  6 ++++++
 tools/test-brackets-groups.mjs |  9 +++++++++
 tools/test-vote-browser.py     | 22 ++++++++++++++++++++++
 vote.html                      |  4 ++++
 9 files changed, 110 insertions(+), 1 deletion(-)

diff --git a/css/arcane-theme.css b/css/arcane-theme.css
index 1045fbc..b1aaaa5 100644
--- a/css/arcane-theme.css
+++ b/css/arcane-theme.css
@@ -1533,3 +1533,19 @@ body.theme-arcane .competitor-column { gap: 1.25rem; }
     body.theme-arcane .info-badge { padding: .4rem .85rem; font-size: .75rem; }
 }
 
+/* ---------- vote button: a long YouTube title (hashtags and all) made it a 7-line pink oval on a phone ----------
+   Rounded rectangle instead of a 999px pill, the label capped at two lines, and the "voted" tick put in FRONT of the text
+   so it can never be clipped. */
+body.theme-arcane .vote-btn { border-radius: 28px; padding: 1rem 1.5rem; }
+body.theme-arcane .vote-btn .vote-text {
+    display: -webkit-box;
+    -webkit-box-orient: vertical;
+    -webkit-line-clamp: 2;
+    overflow: hidden;
+    text-align: center;
+    line-height: 1.3;
+    overflow-wrap: anywhere;
+}
+body.theme-arcane .vote-btn.voted .vote-text::after { content: none; }
+body.theme-arcane .vote-btn.voted .vote-text::before { content: '\2713  '; }
+
diff --git a/css/modal.css b/css/modal.css
index 8dec2f1..bb6caa0 100644
--- a/css/modal.css
+++ b/css/modal.css
@@ -799,3 +799,26 @@
 @media (max-width: 480px) {
     .modal-match-info { flex-direction: row; align-items: center; gap: 0.5rem; }
 }
+
+/* A finished match: shorter titles (two lines) so the result bars are on the first screen, and the two sides share their rows
+   (header / result / thumbnail) so they line up even when one title is longer. */
+.modal-container.is-completed .competitor-name-modal {
+    font-size: 1.4rem;
+    line-height: 1.25;
+    display: -webkit-box;
+    -webkit-box-orient: vertical;
+    -webkit-line-clamp: 2;
+    overflow: hidden;
+}
+@media (min-width: 969px) {   /* the modal is one column below 968 px, as above */
+    .modal-container.is-completed .modal-competitors { grid-template-rows: auto auto auto; row-gap: 0; }
+    .modal-container.is-completed .modal-competitors > .modal-competitor {
+        display: grid;
+        grid-template-rows: subgrid;
+        grid-row: 1 / span 3;
+    }
+    .modal-container.is-completed .modal-competitors > .modal-competitor:first-child { grid-column: 1; }
+    .modal-container.is-completed .modal-competitors > .modal-competitor:last-child { grid-column: 3; }
+    .modal-container.is-completed .modal-competitors > .modal-vs { grid-column: 2; grid-row: 1; }
+}
+
diff --git a/css/vote.css b/css/vote.css
index d75f096..ecbe732 100644
--- a/css/vote.css
+++ b/css/vote.css
@@ -3172,3 +3172,24 @@ body.has-next-bar { padding-bottom: 5.5rem; }
     .competitors-grid > .vs-divider { grid-column: 2; grid-row: 1; }
 }
 
+/* ========================================
+   PHONE ORDER (<= 968 px, one column): player A, vote A, VS, player B, vote B, THEN the "About" blocks.
+   The About block of edit A used to sit between A's vote button and edit B's player, so B's video was about
+   three screens below A's. The columns become transparent (display: contents) so their parts can be re-ordered.
+   ======================================== */
+.details-for { display: none; }
+@media (max-width: 968px) {
+    .competitors-grid { gap: 1.5rem; }
+    #competitor-1-column, #competitor-2-column { display: contents; }
+    #competitor-1-column .competitor-header { order: 1; }
+    #competitor-1-column .video-container   { order: 2; }
+    #competitor-1-column .vote-section      { order: 3; }
+    .competitors-grid > .vs-divider         { order: 4; }
+    #competitor-2-column .competitor-header { order: 5; }
+    #competitor-2-column .video-container   { order: 6; }
+    #competitor-2-column .vote-section      { order: 7; }
+    #competitor-1-column .moment-details    { order: 8; }
+    #competitor-2-column .moment-details    { order: 9; }
+    .details-for { display: block; margin: 0 0 .5rem; font-weight: 800; font-size: .95rem; color: var(--pink-bright, #ff70c3); overflow-wrap: anywhere; }
+}
+
diff --git a/js/brackets-groups.js b/js/brackets-groups.js
index e9d005c..9b118e4 100644
--- a/js/brackets-groups.js
+++ b/js/brackets-groups.js
@@ -99,6 +99,8 @@ export function groupCardHtml(view, opts = {}) {
     const votedCount = view.matches.filter(m => pickOf(m, opts).voted).length;
     const openCount = view.matches.filter(m => m.status === 'live').length;
     const progress = view.complete ? 'Finished' : `${view.played} of ${total} played`;
+    // "0/6 voted" only makes sense while there is something open to vote in; a finished or not-yet-open group with no votes of yours just says how many matches it has
+    const countLabel = (votedCount || openCount) ? `${votedCount}/${total} voted` : `${total} matches`;
     // while matches are open, say how many of them this visitor has voted in; the count inside the Matches list is "voted / total"
     const votedNote = openCount && !view.complete
         ? `<span class="gs-voted-note${votedCount === total ? ' gs-voted-all' : ''}">${votedCount === total ? '&#10003; ' : ''}You voted ${votedCount}/${total}</span>` : '';
@@ -118,7 +120,7 @@ export function groupCardHtml(view, opts = {}) {
             </table>
             ${view.unresolvedTie ? '<p class="gs-note">Places 2 and 3 were level on everything: decided by draw position.</p>' : ''}
             <details class="gs-matches"${view.live ? ' open' : ''}>
-                <summary>Matches <span class="gs-count">${votedCount}/${total} voted</span></summary>
+                <summary>Matches <span class="gs-count">${countLabel}</span></summary>
                 <ul class="gs-match-list">${view.matches.map(m => matchRowHtml(m, opts)).join('')}</ul>
             </details>
         </article>`;
diff --git a/js/vote.js b/js/vote.js
index 1d488ec..5f1f20e 100644
--- a/js/vote.js
+++ b/js/vote.js
@@ -1175,6 +1175,12 @@ if (timeRemaining) {
     if (voteSong1Name) voteSong1Name.textContent = currentMatch.competitor1.name;
     if (voteSong2Name) voteSong2Name.textContent = currentMatch.competitor2.name;
 
+    // the "About" blocks move below both players on a phone, so each says which edit it is about
+    [1, 2].forEach(n => {
+        const el = document.getElementById(`competitor${n}-details-for`);
+        if (el) el.textContent = `About: ${currentMatch['competitor' + n].name || 'this edit'}`;
+    });
+
         // ========================================
         // UPDATE COMPETITOR 1 - BASIC INFO
         // ========================================
diff --git a/tools/test-brackets-browser.py b/tools/test-brackets-browser.py
index 519d3a4..211a5bc 100644
--- a/tools/test-brackets-browser.py
+++ b/tools/test-brackets-browser.py
@@ -180,6 +180,12 @@ with sync_playwright() as p:
         order = pg.evaluate("(()=>{const c=document.querySelector('.modal-competitor');const r=c.querySelector('.modal-result').getBoundingClientRect().top,t=c.querySelector('.modal-video-thumbnail').getBoundingClientRect().top;return r<t})()")
         check(f'modal ({tag}): result bars come before the thumbnail', order)
         check(f'modal ({tag}): no winner tick after the title', pg.evaluate("getComputedStyle(document.querySelector('.modal-competitor.winner .competitor-name-modal'),'::after').content") in ('none', 'normal', '\"\"'))
+        vis = pg.evaluate("(()=>{const b=document.querySelector('.modal-body').getBoundingClientRect(),r=document.querySelector('.result-percentage').getBoundingClientRect();return {resultBottom:r.bottom,bodyBottom:b.bottom}})()")
+        check(f'modal ({tag}): the result is on the first screen (no scrolling needed to see the percentage)', vis['resultBottom'] <= vis['bodyBottom'] + 1, vis)
+        if tag == 'desktop':
+            tops = pg.eval_on_selector_all('.modal-video-thumbnail', 'els=>els.map(e=>Math.round(e.getBoundingClientRect().top))')
+            res = pg.eval_on_selector_all('.modal-result', 'els=>els.map(e=>Math.round(e.getBoundingClientRect().top))')
+            check('modal (desktop): both sides line up (results and thumbnails at the same height)', len(tops) == 2 and abs(tops[0] - tops[1]) <= 2 and abs(res[0] - res[1]) <= 2, (res, tops))
         pg.screenshot(path=f'{SHOTS}/modal-closed-{tag}.png')
         check(f'modal ({tag}): no page errors', not [e for e in errs if 'notification' not in e.lower()], errs)
         pg.context.close()
diff --git a/tools/test-brackets-groups.mjs b/tools/test-brackets-groups.mjs
index 54566de..d8a529e 100644
--- a/tools/test-brackets-groups.mjs
+++ b/tools/test-brackets-groups.mjs
@@ -239,4 +239,13 @@ test('voted state: the old yes/no option still works and an unknown stored value
     assert.ok(odd.includes('6/6 voted') && !odd.includes('gs-check') && !odd.includes('gs-dimmed'));
 });
 
+test('counter: "n/6 voted" only while something is open or you have voted; otherwise it just says "6 matches"', () => {
+    const v = buildGroupViews(midway().ms);
+    assert.ok(groupCardHtml(v[1], {}).includes('0/6 voted'));                         // live group, nothing voted yet
+    assert.ok(groupCardHtml(v[0], { userChoice: () => null }).includes('>6 matches<'));   // finished group, you voted in none of it
+    assert.ok(!groupCardHtml(v[0], { userChoice: () => null }).includes('0/6 voted'));
+    assert.ok(groupCardHtml(v[3], { userChoice: () => null }).includes('>6 matches<'));   // group that has not opened yet
+    assert.ok(groupCardHtml(v[0], { userChoice: () => 'song1' }).includes('6/6 voted')); // finished group you did vote in
+});
+
 console.log(`\n${passed} tests passed`);
diff --git a/tools/test-vote-browser.py b/tools/test-vote-browser.py
index c43d3ee..376ecf0 100644
--- a/tools/test-vote-browser.py
+++ b/tools/test-vote-browser.py
@@ -86,6 +86,28 @@ with sync_playwright() as p:
     pg.screenshot(path=f'{SHOTS}/vote-phone.png')
     pg.context.close()
 
+    # ---------- phone: vote button not a blob, About blocks below both players ----------
+    pg, errs = load(b, 393, 852, voted=False)
+    long_title = 'Bro tried to rizz Jinx - JINX EDIT || Britney Spears - Toxic #jinxedit #jinx #arcane #edit'
+    pg.evaluate("t=>{document.getElementById('vote-song1-name').textContent=t;}", long_title)
+    vb = rect(pg, '#vote-btn-competitor1')
+    radius = pg.evaluate("parseFloat(getComputedStyle(document.querySelector('#vote-btn-competitor1')).borderTopLeftRadius)")
+    check('phone: a very long title no longer makes a huge vote button (two lines at most)', vb['h'] <= 110, vb)
+    check('phone: the vote button is a rounded rectangle, not an oval', radius <= 40, radius)
+    a_vote, b_head, b_vid, a_det, b_det = (rect(pg, s) for s in ('#vote-btn-competitor1', '#competitor2-name', '#competitor2-wrapper', '#competitor-1-column .moment-details', '#competitor-2-column .moment-details'))
+    check('phone: order is player A, vote A, then player B (A\'s About block is not in between)', a_vote['y'] < b_head['y'] < b_vid['y'] < a_det['y'] < b_det['y'], (a_vote['y'], b_head['y'], b_vid['y'], a_det['y'], b_det['y']))
+    check('phone: each About block says which edit it is about', pg.inner_text('#competitor1-details-for').startswith('About: ') and pg.inner_text('#competitor2-details-for').startswith('About: ') and pg.inner_text('#competitor1-details-for') != pg.inner_text('#competitor2-details-for'), pg.inner_text('#competitor1-details-for'))
+    check('phone: second player is within about 1.5 screens of the first (it was about 3)', b_vid['y'] - rect(pg, '#competitor1-wrapper')['y'] < 1.5 * 852, b_vid['y'] - rect(pg, '#competitor1-wrapper')['y'])
+    pg.locator('#competitor-1-column .vote-section').scroll_into_view_if_needed(); pg.wait_for_timeout(200)
+    pg.screenshot(path=f'{SHOTS}/vote-phone-order.png', full_page=False)
+    pg.context.close()
+
+    # desktop keeps the About blocks under their own player
+    pg, errs = load(b, 1280, 900, voted=False)
+    d1, v1 = rect(pg, '#competitor-1-column .moment-details'), rect(pg, '#vote-btn-competitor1')
+    check('desktop: the About block still sits under its own vote button, and its "About:" label is hidden', d1['y'] > v1['b'] and not pg.is_visible('#competitor1-details-for'), (d1, v1))
+    pg.context.close()
+
     # ---------- voted: the Next match bar ----------
     for w, h, tag in ((1280, 900, 'desktop'), (390, 844, 'phone')):
         pg, errs = load(b, w, h, voted=True)
