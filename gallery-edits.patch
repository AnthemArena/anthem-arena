+/* ========================================
+   EDITS GALLERY (music-gallery.html, body.page-gallery)
+   Uses the Arcane theme tokens (--pink-bright, --card, --border ...) from arcane-theme.css.
+   ======================================== */
+.page-gallery .gallery-page {
+    max-width: 1200px;
+    margin: 0 auto;
+    padding: 2.5rem 1.25rem 3rem;
+}
+
+/* ---------- hero ---------- */
+.page-gallery .gallery-hero { text-align: center; margin-bottom: 1.75rem; }
+.page-gallery .gallery-title {
+    margin: 0 0 .6rem;
+    font-family: var(--font);
+    font-size: clamp(2rem, 6vw, 3.25rem);
+    font-weight: 800;
+    letter-spacing: -.01em;
+    color: var(--text);
+}
+.page-gallery .gallery-subtitle {
+    max-width: 640px;
+    margin: 0 auto;
+    color: var(--muted);
+    font-size: 1.05rem;
+    line-height: 1.55;
+}
+
+/* ---------- toolbar ---------- */
+.page-gallery .gallery-toolbar {
+    background: var(--card);
+    border: 1px solid var(--border);
+    border-radius: 18px;
+    padding: 1rem 1.1rem;
+    margin-bottom: 1.5rem;
+}
+.page-gallery .toolbar-row { display: flex; flex-wrap: wrap; gap: .85rem; align-items: flex-end; }
+.page-gallery .toolbar-field { display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
+.page-gallery .toolbar-field[hidden] { display: none; }
+.page-gallery .toolbar-search { flex: 1 1 240px; }
+.page-gallery .toolbar-field label {
+    font-size: .72rem;
+    font-weight: 700;
+    letter-spacing: .08em;
+    text-transform: uppercase;
+    color: var(--pink-bright);
+}
+.page-gallery .toolbar-field input,
+.page-gallery .toolbar-field select {
+    background: rgba(0, 0, 0, .35);
+    color: var(--text);
+    border: 1px solid var(--border);
+    border-radius: 10px;
+    padding: .65rem .8rem;
+    font: 500 .95rem var(--font);
+    min-height: 44px;
+}
+.page-gallery .toolbar-field input::placeholder { color: var(--text-faint); }
+.page-gallery .toolbar-field select option { background: #120a18; color: var(--text); }
+.page-gallery .gallery-toolbar :is(input, select, button):focus-visible,
+.page-gallery .edit-thumb:focus-visible,
+.page-gallery .edit-vote:focus-visible,
+.page-gallery .next-link:focus-visible {
+    outline: 2px solid var(--pink-bright);
+    outline-offset: 2px;
+}
+
+.page-gallery .chip-row { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .9rem; }
+.page-gallery .chip-row[hidden] { display: none; }
+.page-gallery .chip {
+    background: transparent;
+    color: var(--muted);
+    border: 1px solid var(--border);
+    border-radius: 999px;
+    padding: .45rem .95rem;
+    min-height: 40px;
+    font: 600 .88rem var(--font);
+    cursor: pointer;
+    transition: background .15s, color .15s, border-color .15s;
+}
+.page-gallery .chip:hover { color: var(--text); border-color: var(--pink-bright); }
+.page-gallery .chip[aria-pressed="true"] { background: var(--pink-soft); color: var(--pink-bright); border-color: var(--pink-bright); }
+.page-gallery .gallery-count { margin: .9rem 0 0; color: var(--muted); font-size: .9rem; }
+
+/* ---------- grid ---------- */
+.page-gallery .edit-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
+    gap: 1.25rem;
+}
+.page-gallery .gallery-message {
+    grid-column: 1 / -1;
+    text-align: center;
+    padding: 3rem 1rem;
+    background: var(--card);
+    border: 1px solid var(--line);
+    border-radius: 18px;
+    color: var(--muted);
+}
+.page-gallery .gallery-message h3 { margin: 0 0 .5rem; color: var(--text); font-size: 1.2rem; }
+.page-gallery .gallery-message a { color: var(--pink-bright); }
+.page-gallery .gallery-retry {
+    margin-top: 1rem;
+    background: var(--pink-soft);
+    color: var(--pink-bright);
+    border: 1px solid var(--pink-bright);
+    border-radius: 999px;
+    padding: .6rem 1.2rem;
+    min-height: 44px;
+    font: 700 .9rem var(--font);
+    cursor: pointer;
+}
+
+/* ---------- card ---------- */
+.page-gallery .edit-card {
+    display: flex;
+    flex-direction: column;
+    background: var(--card);
+    border: 1px solid var(--line);
+    border-radius: 18px;
+    overflow: hidden;
+    transition: border-color .2s, transform .2s;
+}
+.page-gallery .edit-card:hover { border-color: var(--border); transform: translateY(-2px); }
+
+.page-gallery .edit-thumb {
+    position: relative;
+    display: block;
+    width: 100%;
+    aspect-ratio: 9 / 16;
+    padding: 0;
+    border: 0;
+    background: #000;
+    cursor: pointer;
+    overflow: hidden;
+}
+.page-gallery .edit-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.page-gallery .edit-play {
+    position: absolute;
+    inset: 50% auto auto 50%;
+    transform: translate(-50%, -50%);
+    width: 54px; height: 54px;
+    border-radius: 50%;
+    display: grid; place-items: center;
+    background: rgba(6, 7, 14, .62);
+    border: 1px solid var(--border);
+    color: var(--pink-bright);
+    font-size: 1.1rem;
+    opacity: .9;
+    transition: transform .2s, background .2s;
+}
+.page-gallery .edit-thumb:hover .edit-play { transform: translate(-50%, -50%) scale(1.08); background: var(--pink-soft); }
+.page-gallery .edit-duration {
+    position: absolute; right: .55rem; bottom: .55rem;
+    padding: .15rem .5rem;
+    border-radius: 6px;
+    background: rgba(0, 0, 0, .7);
+    color: var(--text);
+    font: 600 .75rem var(--font);
+}
+.page-gallery .edit-badge {
+    position: absolute; top: .6rem; left: .6rem; right: auto;
+    max-width: calc(100% - 1.2rem);
+    padding: .25rem .65rem;
+    border-radius: 999px;
+    font: 700 .72rem var(--font);
+    letter-spacing: .03em;
+    text-transform: uppercase;
+    background: rgba(6, 7, 14, .78);
+    color: var(--muted);
+    border: 1px solid var(--line);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+.page-gallery .edit-badge.status-live { background: var(--pink); color: #fff; border-color: var(--pink-bright); box-shadow: 0 0 18px rgba(255, 79, 180, .55); }
+.page-gallery .edit-badge.status-champion { background: linear-gradient(135deg, #ff4fb4, #ff9bd6); color: #1a0716; border-color: #ffd0ec; }
+.page-gallery .edit-badge.status-bracket { color: var(--pink-bright); border-color: var(--border); }
+.page-gallery .edit-badge.status-eliminated,
+.page-gallery .edit-badge.status-entered { color: var(--text-dim); }
+
+.page-gallery .edit-body { display: flex; flex-direction: column; gap: .5rem; padding: .85rem .9rem 1rem; flex: 1; }
+.page-gallery .edit-title {
+    margin: 0;
+    font: 700 1rem/1.3 var(--font);
+    color: var(--text);
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+    overflow-wrap: anywhere;
+    min-height: 2.6em;          /* always two lines tall so the stats rows line up across a row of cards */
+}
+.page-gallery .edit-creator {
+    color: var(--pink-bright);
+    font: 600 .88rem var(--font);
+    text-decoration: none;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+.page-gallery a.edit-creator:hover { text-decoration: underline; }
+.page-gallery .edit-stats {
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    gap: .4rem;
+    margin: .25rem 0 0;
+    padding: .6rem 0;
+    border-top: 1px solid var(--line);
+    border-bottom: 1px solid var(--line);
+}
+.page-gallery .edit-stats div { min-width: 0; }
+.page-gallery .edit-stats dt { font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; color: var(--text-dim); }
+.page-gallery .edit-stats dd { margin: .1rem 0 0; font: 700 .95rem var(--font); color: var(--text); font-variant-numeric: tabular-nums; }
+.page-gallery .edit-pills { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: auto; }
+.page-gallery .pill {
+    padding: .15rem .6rem;
+    border: 1px solid var(--line);
+    border-radius: 999px;
+    font: 600 .72rem var(--font);
+    color: var(--muted);
+}
+.page-gallery .pill-cup { color: var(--pink-bright); border-color: var(--border); }
+.page-gallery .edit-vote {
+    display: block;
+    text-align: center;
+    margin-top: .4rem;
+    padding: .65rem;
+    min-height: 44px;
+    background: var(--pink);
+    color: #fff;
+    border-radius: 12px;
+    font: 700 .92rem var(--font);
+    text-decoration: none;
+}
+.page-gallery .edit-vote:hover { background: var(--pink-bright); }
+
+/* ---------- next steps ---------- */
+.page-gallery .gallery-next { display: flex; flex-wrap: wrap; justify-content: center; gap: .85rem; margin-top: 2.5rem; }
+.page-gallery .next-link {
+    display: inline-flex; align-items: center; gap: .6rem;
+    padding: .8rem 1.3rem;
+    min-height: 44px;
+    background: var(--card);
+    border: 1px solid var(--border);
+    border-radius: 999px;
+    color: var(--pink-bright);
+    font: 700 .92rem var(--font);
+    text-decoration: none;
+    transition: background .2s;
+}
+.page-gallery .next-link:hover { background: var(--pink-soft); }
+
+/* ---------- player dialog ---------- */
+.page-gallery .watch-dialog {
+    margin: auto;                 /* main.css resets margin to 0, which un-centres a modal <dialog> */
+    width: min(94vw, 420px);
+    max-height: 96vh;
+    padding: 0;
+    background: #0b0711;
+    color: var(--text);
+    border: 1px solid var(--pink-bright);
+    border-radius: 18px;
+    box-shadow: 0 30px 90px rgba(0, 0, 0, .7), 0 0 40px rgba(255, 79, 180, .18);
+    overflow: hidden;
+}
+.page-gallery .watch-dialog::backdrop { background: rgba(3, 2, 8, .84); backdrop-filter: blur(4px); }
+.page-gallery .watch-head { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .8rem 1rem; border-bottom: 1px solid var(--line); }
+.page-gallery .watch-head h2 { margin: 0; font: 700 1rem var(--font); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.page-gallery .watch-close {
+    flex: none; width: 44px; height: 44px;
+    display: grid; place-items: center;
+    background: var(--pink-soft);
+    color: var(--pink-bright);
+    border: 1px solid var(--border);
+    border-radius: 50%;
+    font-size: 1rem;
+    cursor: pointer;
+}
+.page-gallery .watch-close:focus-visible { outline: 2px solid var(--pink-bright); outline-offset: 2px; }
+.page-gallery .watch-frame-wrap { height: min(68vh, 620px); aspect-ratio: 9 / 16; max-width: 100%; margin: .75rem auto 0; background: #000; }
+.page-gallery .watch-frame-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }
+.page-gallery .watch-meta { margin: 0; padding: .8rem 1rem 1rem; text-align: center; color: var(--muted); font-size: .9rem; }
+.page-gallery .watch-meta a { color: var(--pink-bright); text-decoration: none; }
+.page-gallery .watch-meta a:hover { text-decoration: underline; }
+
+/* ---------- phones ---------- */
+@media (max-width: 560px) {
+    .page-gallery .gallery-page { padding: 1.5rem .85rem 2.5rem; }
+    .page-gallery .edit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
+    /* compact toolbar: search on its own row, status / cup / sort share the next one */
+    .page-gallery .gallery-toolbar { padding: .8rem; margin-bottom: 1.1rem; }
+    .page-gallery .toolbar-row { gap: .6rem; }
+    .page-gallery .toolbar-field { flex: 1 1 0; }
+    .page-gallery .toolbar-field select { padding: .55rem .5rem; font-size: .88rem; }
+    .page-gallery .toolbar-search { flex: 1 1 100%; }
+    .page-gallery .gallery-hero { margin-bottom: 1.1rem; }
+    .page-gallery .gallery-subtitle { font-size: .98rem; }
+    .page-gallery .chip-row { margin-top: .7rem; }
+    .page-gallery .gallery-count { margin-top: .6rem; }
+    .page-gallery .edit-body { padding: .7rem .7rem .85rem; }
+    .page-gallery .edit-title { font-size: .92rem; }
+    .page-gallery .edit-play { width: 44px; height: 44px; }
+    .page-gallery .chip-row { flex-wrap: nowrap; overflow-x: auto; margin-inline: -.2rem; padding: .1rem .2rem .35rem; scrollbar-width: none; }
+    .page-gallery .chip-row::-webkit-scrollbar { display: none; }
+    .page-gallery .chip { flex: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+    .page-gallery .edit-card, .page-gallery .edit-play { transition: none; }
+    .page-gallery .edit-card:hover { transform: none; }
+}
