From 0e1a66b8a0da50af41361aae0b9e640d8cfc98e9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 17:00:30 +0000
Subject: [PATCH] Live page: portrait Shorts covers, two-line titles, dim the
 cover you did not pick; vote page: no empty band above the detail chips

---
 css/live.css               | 28 +++++++++++-
 css/vote.css               |  5 ++
 js/live.js                 |  4 +-
 js/vote.js                 |  1 +
 tools/test-live-browser.py | 93 ++++++++++++++++++++++++++++++++++++++
 tools/test-vote-browser.py |  2 +
 6 files changed, 130 insertions(+), 3 deletions(-)
 create mode 100644 tools/test-live-browser.py

diff --git a/css/live.css b/css/live.css
index 78c68c3..d0d84be 100644
--- a/css/live.css
+++ b/css/live.css
@@ -2838,4 +2838,30 @@ text-align: center;
     .ticker-content .time-ago {
         font-size: 0.75rem;
     }
-}
\ No newline at end of file
+}
+
+/* ========================================
+   SHORTS COVERS (14 Oct)
+   YouTube's thumbnail for a Short is a 4:3 picture with black bars either side of a vertical image. The covers are now
+   9:16 crops of it (object-fit: cover from the centre), so the Short fills the cover instead of sitting in a black box.
+   ======================================== */
+.social-thumbnails img {
+    width: 38%;
+    aspect-ratio: 9 / 16;
+    max-height: 17rem;
+    background: #000;
+}
+.social-thumbnails { align-items: center; justify-content: center; gap: 0.75rem; }
+.social-thumbnails .social-vs { width: auto; flex: none; }
+
+/* titles: two lines at most, so cards in a row stay the same height */
+.social-match-card .song-details h3 {
+    display: -webkit-box;
+    -webkit-box-orient: vertical;
+    -webkit-line-clamp: 2;
+    overflow: hidden;
+}
+
+/* a match you have voted in: the cover you picked keeps its glow, the other one steps back */
+.social-match-card.voted .social-thumbnails:has(img.user-pick) img:not(.user-pick) { opacity: 0.45; filter: grayscale(0.4); }
+
diff --git a/css/vote.css b/css/vote.css
index 22b548c..abb7716 100644
--- a/css/vote.css
+++ b/css/vote.css
@@ -3199,3 +3199,8 @@ body.has-next-bar { padding-bottom: 5.5rem; }
     .moment-details--bare { display: none; }
 }
 
+/* No About text: do not leave an empty band (block padding + the chips' top margin and rule) above the chips */
+.moment-details--no-about { padding-top: 1.1rem; }
+.moment-details--no-about .details-meta { margin-top: 0; }
+.moment-details--no-about .details-meta { padding-top: 0; border-top: 0; }
+
