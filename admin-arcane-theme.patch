+.btn-close { color: var(--text); }
+
+/* status pills: the page puts the status word in the class (status-badge live / upcoming / completed).
+   arcane-theme.css restyles .status-badge for the brackets page, so these rules are scoped to this page to win over it. */
+body.theme-arcane.page-admin .status-badge {
+    display: inline-flex;
+    align-items: center;
+    gap: .4rem;
+    padding: .2rem .7rem;
+    border: 1px solid var(--line);
+    border-radius: 999px;
+    font-size: .76rem;
+    font-weight: 800;
+    letter-spacing: .06em;
+    text-transform: uppercase;
+    color: var(--muted);
+}
+body.theme-arcane.page-admin .status-badge.live, .status-live { border-color: var(--pink-bright); background: var(--pink-soft); color: var(--pink-bright); }
+.status-badge.live::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--pink-bright); box-shadow: 0 0 8px var(--pink-bright); animation: admin-pulse 1.8s ease-in-out infinite; }
+body.theme-arcane.page-admin .status-badge.upcoming, .status-upcoming { border-color: rgba(255, 214, 102, .4); background: rgba(255, 214, 102, .08); color: #ffd666; }
+body.theme-arcane.page-admin .status-badge.completed, .status-completed { border-color: var(--line); background: rgba(255, 255, 255, .04); color: var(--text-dim); }
+.winner-mark { color: var(--pink-bright); font-weight: 800; }
+@keyframes admin-pulse { 50% { opacity: .35; transform: scale(.8); } }
+
+/* ---------- login ---------- */
+#login-container { min-height: 100vh; align-items: center; justify-content: center; padding: 1rem; }
+.login-box {
+    width: min(100%, 26rem);
+    padding: clamp(1.4rem, 4vw, 2.2rem);
+    border: 1px solid var(--border);
+    border-radius: var(--radius);
+    background: var(--panel);
+    backdrop-filter: blur(14px);
+    -webkit-backdrop-filter: blur(14px);
+    box-shadow: var(--shadow);
+}
+.login-box h1 { margin: 0 0 .35rem; font-size: 1.7rem; font-weight: 800; letter-spacing: -.04em; }
+.login-box p { margin: 0 0 1.4rem; color: var(--muted); font-size: .95rem; }
+#login-form { display: grid; gap: .85rem; }
+#login-form input { width: 100%; }
+#login-form .btn-login { width: 100%; margin-top: .25rem; }
+#login-error { min-height: 1.4rem; margin-top: .2rem; color: var(--danger); font-size: .9rem; text-align: center; }
+
+/* ---------- phones ---------- */
+@media (max-width: 640px) {
+    .admin-header { align-items: flex-start; }
+    .button-group > button { flex: 1 1 100%; }
+    .setup-row select { width: 100%; }
+    .form-row > button { flex: 1 1 100%; }
+    .batch-bar { align-items: flex-start; }
+}
+@media (prefers-reduced-motion: reduce) {
+    body.page-admin button, body.page-admin .btn-view { transition: none; }
+    .status-badge.live::before { animation: none; }
 }
