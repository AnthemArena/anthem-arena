diff --git a/css/arcane-theme.css b/css/arcane-theme.css
index b1aaaa5..aad5bb8 100644
--- a/css/arcane-theme.css
+++ b/css/arcane-theme.css
@@ -1549,3 +1549,70 @@ body.theme-arcane .vote-btn .vote-text {
 body.theme-arcane .vote-btn.voted .vote-text::after { content: none; }
 body.theme-arcane .vote-btn.voted .vote-text::before { content: '\2713  '; }
 
+
+/* ========================================
+   16 Oct polish: live page + vote page
+   ======================================== */
+
+/* live banner: "Group B is live! · 6 matches · Ends in ..." as parts that wrap cleanly, with a dot between parts that is
+   only drawn when they share a line (no stray dot at the start of a wrapped line) */
+body.theme-arcane .countdown-content { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: .15rem 0; }
+body.theme-arcane .countdown-content .cd-part { white-space: nowrap; }
+body.theme-arcane .countdown-content .cd-part + .cd-part::before { content: '\2022'; margin: 0 .6rem; opacity: .7; }
+@media (max-width: 520px) {
+    body.theme-arcane .countdown-content { flex-direction: column; align-items: center; }
+    body.theme-arcane .countdown-content .cd-part + .cd-part::before { content: none; }
+}
+
+/* "Founding member" tag sits above the thumbnails on every screen size, not on top of the picked cover */
+body.theme-arcane .social-match-card.voted::before {
+    position: static;
+    display: block;
+    width: fit-content;
+    max-width: calc(100% - 1.5rem);
+    margin: .75rem auto .6rem;
+    box-shadow: none;
+    text-align: center;
+}
+
+/* Community Activity rows: long names are cut with "...", the time stays visible */
+body.theme-arcane .mini-activity-card { min-width: 0; overflow: hidden; }
+body.theme-arcane .mini-activity-card .mini-thumbnail { flex: none; }
+body.theme-arcane .mini-activity-card .mini-info { flex: 1 1 0; min-width: 0; }
+body.theme-arcane .mini-activity-card .mini-user,
+body.theme-arcane .mini-activity-card .mini-song { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+body.theme-arcane .mini-activity-card .mini-time { flex: none; }
+body.theme-arcane .mini-activity-feed .feed-content { min-width: 0; }
+
+/* desktop: open matches first (as on phones), then the progress bar, ticker, hero and activity */
+@media (min-width: 769px) {
+    body.theme-arcane .social-container { display: flex; flex-direction: column; align-items: center; }
+    body.theme-arcane .social-container > * { width: 100%; margin-left: 0; margin-right: 0; box-sizing: border-box; min-width: 0; }
+    body.theme-arcane .social-container > .countdown-banner   { order: 1; }
+    body.theme-arcane .social-container > .unvoted-section    { order: 2; }
+    body.theme-arcane .social-container > .voted-section      { order: 3; }
+    body.theme-arcane .social-container > .no-matches         { order: 4; }
+    body.theme-arcane .social-container > .progress-container { order: 5; }
+    body.theme-arcane .social-container > .activity-ticker    { order: 6; }
+    body.theme-arcane .social-container > .hero-header        { order: 7; }
+    body.theme-arcane .social-container > .mini-activity-feed { order: 8; }
+    body.theme-arcane .social-container > .landing-footer     { order: 9; }
+}
+
+/* vote page: the gold note icon on the pink button read as a faint circle; the label is enough */
+body.theme-arcane .vote-btn .vote-icon { display: none; }
+
+/* vote page: one rule between the chips and the history row, not two or three */
+body.theme-arcane .moment-details .tournament-stats { border-top: 0; border-bottom: 0; padding-top: 0; padding-bottom: 0; }
+
+/* vote page: heading as a small label when the columns below already carry both names */
+body.theme-arcane .match-title.match-title--label {
+    font-size: .85rem;
+    font-weight: 800;
+    letter-spacing: .14em;
+    text-transform: uppercase;
+    color: var(--pink-bright);
+    margin: .25rem 0 .75rem;
+}
+/* no About text: the chips are the first thing in the card, so no rule above them either */
+body.theme-arcane .moment-details--no-about .details-meta { border-top: 0; padding-top: 0; margin-top: 0; }
