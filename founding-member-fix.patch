   // SESSION / SPECIAL
   // ========================================
 
+  // Awarded by js/founding-member-tracker.js (it grants the 500 XP itself),
+  // so the condition never fires here and cannot pay the XP out twice.
+  'founding-member': {
+    id: 'founding-member',
+    name: 'Founding Member',
