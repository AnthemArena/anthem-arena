+
   'long-session': {
     id: 'long-session',
     name: 'Long Session',
diff --git a/js/founding-member-tracker.js b/js/founding-member-tracker.js
index 4262e58..4b33eae 100644
--- a/js/founding-member-tracker.js
+++ b/js/founding-member-tracker.js
@@ -40,6 +40,8 @@ export async function initFoundingMemberTracking(userId) {
