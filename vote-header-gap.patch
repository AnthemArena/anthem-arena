From aefb2e027acc09156393e18e085623a03cb730fa Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 20:53:51 +0100
Subject: [PATCH] Fix tall gap in profile vote cards: scope vote-page header
 padding to the page hero

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013psebDbek43PiPjqCtRkhL
---
 css/arcane-theme.css | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/css/arcane-theme.css b/css/arcane-theme.css
index 8bab50c..70aab98 100644
--- a/css/arcane-theme.css
+++ b/css/arcane-theme.css
@@ -1508,7 +1508,7 @@ body.theme-arcane .settings-modal-container select.setting-input option { backgr
 /* ---------- vote page: a compact header, so the players are on the first screen (14 Oct) ----------
    The page title repeats both edit titles in 3.4rem type (three lines on a laptop) and the two columns repeat them again,
    which pushed the videos below the fold. The title is smaller and capped at two lines; the full titles are still in the columns. */
-body.theme-arcane .vote-header { padding: 4.5rem 0 1.25rem; }
+body.theme-arcane section.vote-header { padding: 4.5rem 0 1.25rem; }   /* the vote page hero only: profile vote cards also have a .vote-header */
 body.theme-arcane .match-title {
     font-size: clamp(1.35rem, 2.7vw, 2.2rem);
     letter-spacing: -.03em;
@@ -1519,7 +1519,7 @@ body.theme-arcane .match-title {
 }
 body.theme-arcane .match-info { margin-top: .75rem; }
 @media (max-width: 768px) {
-    body.theme-arcane .vote-header { padding: 3.5rem 0 1rem; }
+    body.theme-arcane section.vote-header { padding: 3.5rem 0 1rem; }
 }
 body.theme-arcane .voting-arena { padding: 1.75rem 0 4rem; }
 body.theme-arcane .competitor-column { gap: 1.25rem; }
