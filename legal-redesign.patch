@@ -0,0 +1,34 @@
+/* ========================================
+   LEGAL PAGES (legal/terms, privacy, disclosure: body.page-legal)
+   Uses the Arcane theme tokens from arcane-theme.css.
+   ======================================== */
+.page-legal .legal-page { max-width: 800px; margin: 0 auto; padding: 2.5rem 1.25rem 3.5rem; }
+.page-legal .legal-hero { text-align: center; margin-bottom: 1.5rem; }
+.page-legal .legal-title { margin: 0 0 .6rem; font-family: var(--font); font-size: clamp(2rem, 6vw, 3.25rem); font-weight: 800; letter-spacing: -.01em; color: var(--text); }
+.page-legal .legal-subtitle { max-width: 560px; margin: 0 auto; color: var(--muted); font-size: 1.05rem; line-height: 1.55; }
+.page-legal .legal-updated { margin: .7rem 0 0; color: var(--text-faint); font-size: .85rem; }
+
+.page-legal .legal-switch { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-bottom: 1.75rem; }
+.page-legal .legal-switch a { min-height: 44px; display: inline-flex; align-items: center; padding: .5rem 1.1rem; background: var(--card); border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font-weight: 600; text-decoration: none; }
+.page-legal .legal-switch a:hover { color: var(--text); background: var(--pink-soft); }
+.page-legal .legal-switch a[aria-current="page"] { color: var(--text); background: var(--pink-soft); border-color: var(--pink-bright); }
+.page-legal .legal-switch a:focus-visible, .page-legal .legal-card a:focus-visible { outline: 2px solid var(--pink-bright); outline-offset: 2px; }
+
+.page-legal .legal-plain { margin-bottom: 1rem; padding: 1.1rem 1.25rem; background: var(--pink-soft); border: 1px solid var(--border); border-left: 3px solid var(--pink-bright); border-radius: 14px; }
+.page-legal .legal-plain strong { color: var(--pink-bright); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
+.page-legal .legal-plain p { margin: .4rem 0 0; color: var(--text); line-height: 1.6; }
+
+.page-legal .legal-card { margin-bottom: 1rem; padding: 1.4rem 1.5rem; background: var(--card); border: 1px solid var(--border); border-radius: 18px; }
+.page-legal .legal-card h2 { margin: 0 0 .7rem; font-size: 1.2rem; color: var(--text); letter-spacing: -.01em; }
+.page-legal .legal-card p { margin: 0 0 .75rem; color: var(--muted); line-height: 1.7; overflow-wrap: anywhere; }
+.page-legal .legal-card p:last-child, .page-legal .legal-card ul:last-child { margin-bottom: 0; }
+.page-legal .legal-card ul { margin: 0 0 .75rem; padding-left: 1.2rem; color: var(--muted); line-height: 1.7; }
+.page-legal .legal-card li { margin-bottom: .45rem; overflow-wrap: anywhere; }
+.page-legal .legal-card li::marker { color: var(--pink-bright); }
+.page-legal .legal-card strong { color: var(--text); }
+.page-legal .legal-card a { color: var(--pink-bright); text-decoration: underline; text-underline-offset: 2px; }
+
+@media (max-width: 640px) {
+    .page-legal .legal-page { padding: 1.75rem 1rem 2.5rem; }
+    .page-legal .legal-card { padding: 1.15rem 1.1rem; }
+}
