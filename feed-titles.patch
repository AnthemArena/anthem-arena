+    assert.equal(tidyNames('no names here', [a]), 'no names here');
+    assert.equal(tidyNames('same ' + a + ' twice ' + a, [a, a]), 'same Bro tried to rizz Jinx \u{1F480} twice Bro tried to rizz Jinx \u{1F480}');
